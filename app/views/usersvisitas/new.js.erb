<% if @active_record.present? %>
	$("#usersvisita_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersvisita: @active_record %>");
<% end %>
$("#usersvisita_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#usersvisita_form").collapse("show");
$(".select2").select2();


$(function () {
	return $('.select2Users').select2({
		minimumInputLength: 3,
		maximumInputLength: 20,
		placeholder: "[ Seleccionar Usuario... ]",
		ajax: {
			url: '/usersvisitas/searchUsuarios.json',
			dataType: 'json',
			delay: 250,
			data: function (params) {
				return {
					q: params.term,
					page: params.page
				};
			},
			processResults: function (data) {
				return {
					results: $.map(data, function (item) {
						return {
							text: item.name,
							id: item.id
						};
					})
				};
			}
		}
	});
});