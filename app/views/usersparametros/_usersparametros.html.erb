<div class="box box-primary">
  <div class="box-header">
    <h3 class="box-title">Parametros asignados</h3>
    <div class="box-tools pull-right">

      <%= link_to new_user_usersparametro_path(@user), remote: true, id: 'new_usersparametro_button', class: 'btn btn-sm btn-info' do %>
        <i class="fa fa-plus-square"> </i> <span>Agregar Nuevo Permiso</span>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="usersparametro_form" class="collapse"></div>
    <div id="usersparametros">
      <% if @user.usersparametros.present? %>
        <%= render 'usersparametros/tabla' %>
      <% else %>
        <div class="alert alert-warning">
          <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
      <% end %>
    </div>
  </div>
</div>
