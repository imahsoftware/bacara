<% if @active_record.present? %>
	$("#usersvehiculo_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersvehiculo: @active_record %>");
<% end %>
$("#usersvehiculo_form").html("<%= j render 'form' %>");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#usersvehiculo_form").collapse("show");
