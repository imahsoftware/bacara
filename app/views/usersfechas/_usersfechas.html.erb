<div class="box box-primary">
  <div class="box-header">
    <legend>Fechas Habilitadas</legend>
    <div class="box-tools pull-right">
      <%= link_to new_user_usersfecha_path(@user), id: 'new_usersfecha_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="usersfecha_form" class="collapse"></div>
    <div id="usersfechas">
      <% if @user.usersfechas.present? %>
        <%= render 'usersfechas/tabla' %>
      <% else %>
        <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>
