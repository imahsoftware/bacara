<div class="table-responsive">
	<table class="table table-bordered">
	  <thead>
	    <tr class="thcolor">
				<th width="10%"></th>
        <th><%= t :assignment_date %></th>
        <th class="text-center"><%= t :start_time %></th>
    		<th class="text-center"><%= t :end_time %></th>
    		<th class="text-center"><%= t :interval %></th>
    		<th class="text-center"><%= t :number_of_people_per_interval %></th>
    		<th class="text-center"><%= t :status %></th>
	    </tr>
	  </thead>
	  <tbody id="tbody_usersfechas">
	    <% @user.usersfechas.each do |usersfecha| %>
	      <%= render 'usersfechas/tr', usersfecha: usersfecha %>
	    <% end %>
	  </tbody>
	</table>
</div>
