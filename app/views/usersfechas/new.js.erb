<% if @active_record.present? %>
	$("#usersfecha_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersfecha: @active_record %>");
<% end %>
$("#usersfecha_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#usersfecha_form").collapse("show");
$(".select2").select2();
