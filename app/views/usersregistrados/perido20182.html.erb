

<%#= params[:controller].singularize.classify.constantize %>
<%#= params[:controller].singularize.classify.constantize.attribute_names %>
<div class="box box-primary">
  <div class="box-header">
    <h3 class="box-title"><strong>Formularios (<%= @periodo %>)</strong></h3>
      <%= link_to new_formulario_path, class: 'btn btn-xs btn-primary' do %>
        <i class="fa fa-plus-square"> </i> <span></span>
      <% end %>
        <div class="box-tools">
        <%= search_form_for @q do |f| %>
          <div class="input-group input-group-sm" style="width: 150px;">
            <%= f.search_field :identificacion_cont, class: 'form-control pull-right', placeholder: 'Buscar...' %>
          <div class="input-group-btn">
            <button type="submit" class="btn btn-default"><i class="fa fa-search"></i></button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<div class="box-header with-border">
  <div class="row">
    <div class="col-md-12">
      <div class="table-responsive">
        <table class="table table-striped table-responsive">
          <thead>
            <tr>
              <th class="tabco5" width="15%">Identificación</th>
              <th class="tabco5" width="20%">Nombre</th>
              <th class="tabco5" width="15%">Teléfonos</th>
              <th class="tabco5" width="45%">Universidad</th>
              <th class="tabco5" width="5%"></th>
            </tr>
          </thead>
          <tbody>
          <% @formularios.each do |formulario| %>
            <tr>
              <td style="font-size: 11px;"><%= formulario.identificacion rescue nil %></td>
              <td style="font-size: 11px;"><%= formulario.nombres.upcase rescue nil%></td>
              <td style="font-size: 11px;"><%= formulario.telefono rescue nil%> - <%= formulario.celular rescue nil%>
              <td style="font-size: 11px;"><%= Universidad.find(formulario.universidad_id).nombre.to_s rescue nil %><br/>
              <strong>Programa:</strong> <%=h formulario.programas.upcase rescue nil %></td>
              </td>
              <td class="pull-rigth">
              <%= link_to edit_formulario_path(etapa: "A", id: formulario.id) do %>
              <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
              <% end %>
              <% if is_authorized%>
              <%= link_to formulario, method: :delete, data: { confirm: 'Esta seguro?' } do %>
              <button class="btn btn-xs btn-danger"><i class="fa fa-close"></i></button>
              <% end %>
              <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
      <div class="box-footer"><%= paginate @formularios %></div>
      </div>
    </div>
  </div>
  </div>


