<div class="box box box-solid box-primary collapsed-box">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-file-excel-o" aria-hidden="true"></i><strong> Formularios de inscripción
      2018</strong></h3>
    <div class="box-tools pull-right">
      <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-plus"></i></button>
      <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-remove"></i></button>
    </div>
  </div>
  <div class="box-body" style="display: none;">
    <div class="row">
      <div class="col-md-12">
        <div class="box-tools pull-left">
          <%= link_to consolidado_formularios_path(periodo: '2018-2'), class: "btn btn-warning" do %>
            <i class="fa fa-arrow-circle-down"></i><span></span> Informe General
          <% end -%>
        </div>
      </div>
    </div>
  </div>
</div>