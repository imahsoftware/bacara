<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <th width="10%"></th>
        <th width="25%"><%= t :field %></th>
        <th><%= t :description %></th>
        <th width="20%"><%= t :code_aportesenlínea %></th>
        <th width="10%"><%= t :status %></th>
        <th width="10%"><%= t :visible %></th>
      </tr>
    </thead>
    <tbody id="tbody_iparametros">
      <%
        @is_auth_e_iparametro = is_auth_e('iparametro')
        @iparametros.order("campo,descripcion asc").each do |iparametro| %>
        <%= render 'iparametros/tr', iparametro: iparametro %>
      <% end %>
    </tbody>
  </table>
</div>