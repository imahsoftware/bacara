<% if @active_record.present? %>
	$("#iparametro_<%= @active_record.id %>").replaceWith("<%= j render 'tr', iparametro: @active_record %>");
<% end %>
$("#iparametro_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#iparametro_form").collapse("show");
$(".select2").select2();