<div class="box box-primary">
  <div class="box-header">
    <h3 class="box-title">Permisos Asociados</h3>
      <div class="box-tools pull-right">
        <%= link_to new_user_userspermiso_path(@user), remote: true, id: 'new_userspermiso_button', class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"> </i> <span>Agregar Nuevo Permiso</span>
        <% end %>
      </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="userspermiso_form" class="collapse"></div>
    <div id="userspermisos">
      <% if @user.userspermisos.present? %>
        <%= render 'userspermisos/tabla' %>
      <% else %>
        <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>
