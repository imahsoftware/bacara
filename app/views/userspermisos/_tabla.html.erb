<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
	  <thead>
	    <tr class="thcolor">
				<th width="10%"></th>
        <th><%= t :permission %></th>
        <th><%= t :creates %></th>
        <th><%= t :updates %></th>
        <th><%= t :deletes %></th>
	    </tr>
	  </thead>
	  <tbody id="tbody_userspermisos">
	    <% @user.userspermisos.includes([:objeto]).order(updated_at: :desc).each do |userspermiso| %>
	      <%= render 'userspermisos/tr', userspermiso: userspermiso %>
	    <% end %>
	  </tbody>
	</table>
</div>
