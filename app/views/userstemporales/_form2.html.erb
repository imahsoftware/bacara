<%= simple_form_for @userstemporal, :url => create2_userstemporales_path, :method => :post, remote: true do |f| %>
  <section class="content-header"><%= render 'layouts/flash_messages' %></section>
  <div class="box-header"><h3 class="box-title">Registro Rapido Usuarios</h3></div>
  <div class="box-body">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :identificacion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Identificación' %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :nombre, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Nombres' %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
        <%= f.input :email, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Email' %>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2">
        <%= f.input :celular, :input_html => {:onChange => "javascript:this.value=this.value.toUpperCase();"}, label: 'Celular' %>
      </div>
    </div>
  </div>
  <div class="box-footer">
    <div class="box-tools pull-right">
      <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
    </div><!-- /.box-tools -->
  </div>
<% end %>