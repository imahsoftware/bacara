<legend style="margin-top: -19px;">Seguimiento Convocatorias</legend>
<% estados = []
   usr = current_user
   @query.each do |cargue|
     estados << cargue[0]
   end
%>
<div class="row">
  <div class="col-md-12">
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <%
          estados.each do |p|
            if usr.etapa.to_s == p
              clase = "active"
            else
              clase = ""
            end
        %>
          <li class="<%=clase%>">
            <%= link_to etaparformulario_migraciones_path(etapa: p) do %>
              <i class="fa fa-adn"></i>&nbsp;<%=p %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="tab-content">
        <% cont = 0
           clase = ""

           @query.each do |c|
             e = c[0].to_s
             if usr.etapa.to_s == e
        %>
            <div class="tab-pane active" id="<%=e %>">
              <div class="box-body">
                <% if e.to_s == 'CARGUE CANDIDATOS' %>
                  <%= render 'otrosformulariospersonas' %>
                <% elsif e.to_s == 'CARGUE MINICONTRATACION' %>
                  <%= render 'otrosminicontratacion' %>
                <% elsif e.to_s == 'BUSCADOR' %>
                  <%= render 'buscadorformulariospersonas' %>
                <% elsif e.to_s == 'SEGUIMIENTO' %>
                  <%= render 'seguimientoformulariospersonas' %>
                <% elsif e.to_s == 'EXAMENES' or e.to_s == 'EXAMENESESTADOS'  %>
                  <%= render 'otrosformulariosexamenes' %>
                <% elsif e.to_s == 'VACANTES' %>
                  <%= render 'vacantes' %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
