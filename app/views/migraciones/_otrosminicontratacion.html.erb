<legend>Cargue Mini-Contratacion</legend>
<%
  codigomigracion = 30
  valuecargue = 'migracionespersonas'
  @archivo = Archivo.new
%>
<div class="row">
  <div class="col-md-5">
    <div class="box box-primary">
      <div class="box-body">
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead class="thcolor">
            <tr>
              <td colspan="4" class="text-center"><strong>Orden del archivo</strong></td>
            </tr>
            <tr style="font-size: 12px;">
              <td class="text-center" width="10%"><strong>Orden</strong></td>
              <td class="text-center"><strong>Encabezado</strong></td>
              <td class="text-center" width="20%"><strong><%= t(:detail_label) %></strong></td>
            </tr>
            </thead>
            <tbody>
            <% Migracionescampo.where(["migracion_id = #{codigomigracion}"]).order("orden asc").each do |migracionescampo| %>
              <tr style="font-size: 12px;">
                <td class="text-center"><%= migracionescampo.orden rescue nil %></td>
                <td class="text-left"><%= migracionescampo.encabezado rescue nil %></td>
                <td class="text-center"><%= migracionescampo.detalle rescue nil %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="col-md-6" align="left" style="padding-left: 0px">
          <%= link_to headxls_datas_path(id: codigomigracion, format: :xlsx) do %>
            <button class="btn btn-xs btn-warning"><i class="fa fa-file-excel-o"></i> Estructura de Encabezados</button>
          <% end %>
        </div>
        <div class="col-md-6" align="right" style="padding-left: 0px">
          <%= link_to codigos_datas_path(format: :xlsx) do %>
            <button class="btn btn-xs btn-success"><i class="fa fa-file-excel-o"></i> Codigos de Cargue</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-7">
    <div class="box box-primary">
      <% if is_auth_c("contratacionconv") %>
        <%= simple_form_for [@archivo], wrapper: :inline_form, html: { class: 'form-inline' } do |f| %>
          <%= f.hidden_field :migracion, value: 'migracionespersonas2' %>
          <div class="box-header">
            <div class="alert alert-danger">
              <h4><i class="icon fa fa-info"></i> Atención!</h4>
              Recuerde que el archivo debe ser con extensión <strong>XLS</strong> o <strong>XLSX</strong>. <br/>DEBE tener
              encabezados <br/>DEBE ser en el orden establecido
            </div>
          </div>
          <div class="box-body">
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <label>Contrato</label><br/>
                <%= f.input :datoid, collection: select_contratos_activos.collect {|p| [ p.datos.to_s, p.id ] }, input_html: { data: { width: '600px' }, class: 'select2' }, as: :select, include_blank: true, label: "Contrato" %>
              </div>
            </div>
            <div class="row">
              <div class="col-md-12">
                <label>Archivo</label><br/>
                <div class="input-group">
                    <span class="input-group-btn">
                      <button id="fake-file-button-browse" type="button" class="btn btn-default">
                        <span class="glyphicon glyphicon-file"></span>
                      </button>
                    </span>
                  <%= f.input :documentos, as: :file, label: false, input_html: { id: 'files-input-upload', style: 'display:none;', data: { toggle: 'tooltip' }, title: 'Seleccionar Archivo' } %>
                  <input type="text" id="rutaarchivo" disabled="disabled" placeholder="<%= t(:no_file_selected) %>" class="form-control" style="width: 187px">
                  <span class="input-group-btn">
                      <%= f.button :submit, "Cargar", class: "btn btn-primary", disabled: true, id: 'fake-file-button-upload', data: { toggle: 'tooltip', disable_with: "#{t :procesando}" }, title: 'Cargar Archivo' %>
                    </span>
                  <script type="text/javascript">
                      // Fake file upload
                      document.getElementById('fake-file-button-browse').addEventListener('click', function () {
                          document.getElementById('files-input-upload').click();
                      });

                      document.getElementById('files-input-upload').addEventListener('change', function () {
                          document.getElementById('rutaarchivo').value = this.value.replace(/C:\\fakepath\\/, '');
                          document.getElementById('fake-file-button-upload').removeAttribute('disabled');
                      });
                  </script>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      <%
        datos = Objeto.find_by_sql(["select m.archivo_id, (SELECT documentos_file_name FROM archivos where id = m.archivo_id) archivodetalle,
                                          SUM(CASE WHEN m.estado ='APLICADO' THEN 1 ELSE 0 END) aplicado, SUM(CASE WHEN m.estado ='NO APLICADO' THEN 1 ELSE 0 END) no_aplicado
                                     from  #{valuecargue.to_s} m WHERE minicontratacion = 'SI' group by archivo_id order by archivo_id desc LIMIT 15"])
        if datos.present?
      %>
        <table class="table table-bordered table-condensed table-striped">
          <thead class="thcolor">
          <tr>
            <td width="15%" class="text-center" style="font-size: 10px;"><strong></strong></td>
            <td class="text-center" style="font-size: 10px;"><strong>Lote</strong></td>
            <td class="text-left" style="font-size: 10px;"><strong>Archivo Cargado</strong></td>
            <td width="10%" class="text-center" style="font-size: 10px;"><strong>Cargados</strong></td>
            <td width="12%" class="text-center" style="font-size: 10px;"><strong>No Cargados</strong></td>
          </tr>
          </thead>
          <tbody>
          <% datos.each do |ma| %>
            <tr>
              <td class="text-center" style="font-size: 10px;">
                <% if ma.no_aplicado.to_i > 0 %>
                  <%= link_to errores_archivos_path(archivo_id: ma.archivo_id, migracion_id: codigomigracion, format: :xlsx, candidato: 'S'), data: { toggle: 'tooltip' }, title: 'Inconsistencias' do %>
                    <button class="btn btn-xs btn-danger"><i class="fa fa-plus-square"></i></button>
                  <% end %>
                <% end %>
                <% if ma.aplicado.to_i > 0 %>
                  <%= link_to abrir_registros_personasformularios_path(archivo_id: ma.archivo_id), remote: true, data: { toggle: 'tooltip' }, title: 'Abrir Registros' do %>
                    <button class="btn btn-xs btn-success"><i class="fa fa-users"></i></button>
                  <% end %>
                <% end %>
              </td>
              <td class="text-center" style="font-size: 10px;"><%= ma.archivo_id rescue nil %></td>
              <td style="font-size: 10px;"><%= ma.archivodetalle rescue nil %></td>
              <td class="text-center" style="font-size: 10px;"><%= ma.aplicado rescue nil %></td>
              <td class="text-center" style="font-size: 10px;"><%= ma.no_aplicado rescue nil %></td>
            </tr>
            <div class="modal fade" id="abrircargue<%= ma.archivo_id %>">
              <div class="modal-dialog modal-dialog-responsive" role="document">
                <div class="modal-content"></div>
              </div>
            </div>
          <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>