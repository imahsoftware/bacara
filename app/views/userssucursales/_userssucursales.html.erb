<div class="box box-primary">
  <div class="box-header">
    <legend>Sucursales</legend>
    <div class="box-tools pull-right">
      <%= link_to new_user_userssucursal_path(@user), id: 'new_userssucursal_button', class: 'btn btn-sm btn-info', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    </div>
  </div>
  <div class="flash_messages"></div>
  <div class="box-body">
    <div id="userssucursal_form" class="collapse"></div>
    <div id="userssucursales">
      <% if @user.userssucursales.present? %>
        <%= render 'userssucursales/tabla' %>
      <% else %>
        <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>
