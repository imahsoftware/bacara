$(".alert_flash").fadeOut(300, function() {
	$(this).remove();
});

<% if @user.userssucursales.count == 1 %>
	$("#userssucursales").html("<%= j render 'tabla' %>");
<% else %>
	$("#tbody_userssucursales").prepend("<%= j render 'tr', userssucursal: @userssucursal %>");
<% end %>

$(".clean").val("").trigger('change');

$("#userssucursal_form").collapse("hide");

$("#userssucursal_form").empty();

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
	$(".alert_flash").fadeOut(300, function() {
		$(this).remove();
	});
}, 5000);
