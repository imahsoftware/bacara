$("#usersreporte_form").collapse("hide");

$("#usersreporte_form").empty();

<% if @active_record.present? %>
	$("#usersreporte_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersreporte: @active_record %>");
<% end %>

$("#usersreporte_<%= @usersreporte.id %>").html("<td colspan='2'><%= j render 'form' %></td>");

$("#usersreporte_<%= @usersreporte.id %>").addClass("active_usersreporte");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
