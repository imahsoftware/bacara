<div class="box box-primary">
  <div class="box-header">
    <h3 class="box-title"><%= t :associated_reports %></h3>
      <div class="box-tools pull-right">
        <%= link_to new_user_usersreporte_path(@user), remote: true, id: 'new_usersreporte_button', class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-plus-square"> </i> <span><%= t :add_new_permission %></span>
        <% end %>
      </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="usersreporte_form" class="collapse"></div>
    <div id="usersreportes">
      <% if @user.usersreportes.present? %>
        <%= render 'usersreportes/tabla' %>
      <% else %>
        <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <% end %>
    </div>
  </div>
</div>
