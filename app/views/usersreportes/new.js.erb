<% if @active_record.present? %>
	$("#usersreporte_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersreporte: @active_record %>");
<% end %>
$("#usersreporte_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#usersreporte_form").collapse("show");
$(".select2").select2();
