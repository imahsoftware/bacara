<div class="error-box">
  <div class="login-logo edupol-logo2">

  </div>
  <div class="form-login">
  	<div class="row">
  		<div class="col-md-4 text-center" style="color: #20447d;">
  			<span class="fa-stack fa-4x">
		  		<i class="fa fa-square-o fa-stack-2x"></i>
		  		<i class="fa fa-exclamation-triangle fa-stack-1x"></i>
		  	</span>
  		</div>
  		<div class="col-md-8 text-center" style="color: #20447d;">
  			<h4>
					<%= t :page_not_found %>
				</h4>
				<h4><%= Time.now.strftime("%Y-%m-%d %H:%M:%S %p") %></h4>
  		</div>
  	</div>
  	<hr>
  	<div class="text-center" style="color: #20447d;">
			<h4 style="color: red;">
				<%= t :return_to_previous %> <%= link_to root_path do %><button class="btn btn-sm btn-danger"><%= t :here %></button><% end %>
			</h4>
  	</div>
  </div>
</div>