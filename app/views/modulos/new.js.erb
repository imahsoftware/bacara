<% if @active_record.present? %>
	$("#modulo_<%= @active_record.id %>").replaceWith("<%= j render 'tr', modulo: @active_record %>");
<% end %>
$("#modulo_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#modulo_form").collapse("show");
$(".select2").select2();
