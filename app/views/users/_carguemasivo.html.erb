<div class="modal-header">
  <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
  <h3 class="modal-title"><strong><%= t :carga_masiva_usuarios %></strong></h3>
  <div class="alert alert-danger">
    <h4><i class="icon fa fa-info"></i> <%= t :atencion %>!</h4>
      <%= t :recuerde_archivo %>
  </div>
	<div class="table-responsive">
    <table class="table table-bordered table-condensed table-striped">
	    <thead class="thcolor">
	      <tr>
	        <td colspan="4" class="text-center"><strong><%= t :orden_archivo %></strong></td>
	      </tr>
	      <tr style="font-size: 12px;">
	        <td class="text-center"><strong><%= t :orden %></strong></td>
	        <td class="text-center"><strong><%= t :descripcion %></strong></td>
	        <td class="text-center"><strong><%= t :formato %></strong></td>
	        <td class="text-center"><strong><%= t :obligatorio %></strong></td>
	      </tr>
	    </thead>
	    <tbody>
	      <tr style="font-size: 12px;">
	       <td class="text-center">1</td>
	       <td class="text-left"><%= t :nombre_completo %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">2</td>
	       <td class="text-left"><%= t :identificacion_campo %></td>
	       <td class="text-center"><%= t :sin_separadores %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">3</td>
	       <td class="text-left"><%= t :nombre_usuario %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">4</td>
	       <td class="text-left"><%= t :email_campo %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">5</td>
	       <td class="text-left"><%= t :tipo_consulta %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">6</td>
	       <td class="text-left"><%= t :contrasena_campo %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :si %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">7</td>
	       <td class="text-left"><%= t :sucursal_id %></td>
	       <td class="text-center"><%= t :numerico %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">8</td>
	       <td class="text-left"><%= t :cargo_id %></td>
	       <td class="text-center"><%= t :numerico %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">9</td>
	       <td class="text-left"><%= t :telefono_campo %></td>
	       <td class="text-center"><%= t :sin_separadores %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">10</td>
	       <td class="text-left"><%= t :celular_campo %></td>
	       <td class="text-center"><%= t :sin_separadores %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">11</td>
	       <td class="text-left"><%= t :direccion_campo %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">12</td>
	       <td class="text-left"><%= t :ciudad_campo %></td>
	       <td class="text-center"><%= t :alfabetico %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">13</td>
	       <td class="text-left"><%= t :genero_campo %></td>
	       <td class="text-center"><%= t :alfanumerico %> (MALE - FEMALE)</td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">14</td>
	       <td class="text-left"><%= t :fecha_nacimiento_campo %></td>
	       <td class="text-center"><%= t :fecha_formato %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">15</td>
	       <td class="text-left"><%= t :fecha_inicio_campo %></td>
	       <td class="text-center"><%= t :fecha_formato %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">16</td>
	       <td class="text-left"><%= t :observaciones_campo %></td>
	       <td class="text-center"><%= t :alfanumerico %></td>
	       <td class="text-center"><%= t :no %></td>
	      </tr>
	      <tr style="font-size: 12px;">
	       <td class="text-center">17</td>
	       <td class="text-left"><%= t :extension_campo %></td>
	       <td class="text-center">Alfanumerico</td>
	       <td class="text-center">NO</td>
	      </tr>
	    </tbody>
	  </table>
	</div>
</div>
<div class="modal-body">
	<%= form_tag importar_users_path, multipart: true do %>
		<div class="row">
	    <div class="col-md-12">
	      <div class="input-group">
	          <span class="input-group-btn">
	      		<button id="fake-file-button-browse" type="button" class="btn btn-default">
	      			<span class="glyphicon glyphicon-file"></span>
	      		</button>
	      	</span>
	        <%= file_field_tag(:file, id: 'files-input-upload', style: 'display:none', data: { toggle: 'tooltip' }, title: 'Seleccionar Archivo') %>
	        <input type="text" id="rutaarchivo" disabled="disabled" placeholder="No has seleccionado el archivo" class="form-control">
	      	<span class="input-group-btn">
	          <%= button_tag(type: "submit", class: "btn btn-primary", disabled: true, id: 'fake-file-button-upload', data: { toggle: 'tooltip', disable_with: "#{t :procesando}" }, title: 'Cargar Archivo') do %>
	          	<span class="fa fa-upload"></span>
	      		<% end %>
	      	</span>
	      </div>
	      <script type="text/javascript">
	        document.getElementById('fake-file-button-browse').addEventListener('click', function() {
	        	document.getElementById('files-input-upload').click();
	        });

	        document.getElementById('files-input-upload').addEventListener('change', function() {
	        	document.getElementById('rutaarchivo').value = this.value.replace(/C:\\fakepath\\/,'');
	        	document.getElementById('fake-file-button-upload').removeAttribute('disabled');
	        });
	      </script>
	    </div>
	  </div>
	<% end %>
</div>