<aside class="main-sidebar">

  <!-- sidebar: style can be found in sidebar.less -->
  <section class="sidebar">

    <!-- Sidebar user panel (optional) -->
    <div class="user-panel">
      <div class="pull-left info">
        <p><%= t :users %></p>
        <%= link_to users_path do %>
                    <i class="fa fa-circle text-success"></i><span><%= t :return %></span>
          <% end %>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <ul class="sidebar-menu" data-widget="tree">
      <li class="header"><%=t :menu%></li>
      <!-- Optionally, you can add icons to the links -->
      <% unless @user.new_record? %>
      <li class="treeview">
        <li>
          <%= link_to edit_user_path(etapa: "A", id: @user.id) do %>
                    <i class="fa fa-bullseye"></i><span><%= t :datos_basicos %></span>
          <% end %>
        </li>
        <li>
          <%= link_to edit_user_path(etapa: "B", id: @user.id) do %>
                    <i class="fa fa-bullseye"></i> <span><%= t :modulos %></span>
          <% end %>
        </li>
        <li>
           <%= link_to edit_user_path(etapa: "C", id: @user.id) do %>
                  <i class="fa fa-bullseye"></i> <span><%= t :permisos %></span>
           <% end %>
        </li>
        <li>
           <%= link_to edit_user_path(etapa: "D", id: @user.id) do %>
                  <i class="fa fa-bullseye"></i> <span><%= t :schedule %></span>
           <% end %>
        </li>
        <li>
           <%= link_to edit_user_path(etapa: "E", id: @user.id) do %>
                  <i class="fa fa-bullseye"></i> <span><%= t :images %></span>
           <% end %>
        </li>
      </li>
      <% end %>
    </ul>
    <!-- /.sidebar-menu -->
  </section>
  <!-- /.sidebar -->
</aside>
