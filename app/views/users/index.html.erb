<% title t(:users) %>
<% issygma = is_sygma
   isadmin = is_admin
%>
<div class="box box-primary">
  <div class="box-header" style="margin-bottom: -32px;">
    <legend><%= t :users %></legend>
    <div class="box-tools pull-right">
      <%= link_to desbloquearusuariof_users_path, data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:unlock_all_users), class: 'btn btn-sm btn-warning' do %>
        <i class="fa fa-unlock-alt"> </i> <span><%= t :unlock_all_users %></span>
      <% end %>
      <% pendientes_ext = (@pendientes.count + @expirados_sin_respuesta.count) rescue 0 %>
      <% if pendientes_ext > 0 %>
        <span class="btn btn-sm btn-danger" style="cursor:default;">
          <i class="fa fa-clock-o"></i> <%= t(:extension_requests_index_button) %>
          <span class="badge" style="background:#fff; color:#c0392b;"><%= pendientes_ext %></span>
        </span>
      <% end %>
      <%= link_to new_user_path, class: 'btn btn-sm btn-info' do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :new_user %></span>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <div class="box-tools pull-right">
            <%= form_tag users_path, method: :get, id: "search-form" do %>
              <div class="input-group" style="width: 550px;">
                <%= hidden_field_tag :user_id %>
                <%= autocomplete_field_tag :nombre,'', autocomplete_user_nombre_users_path, class: "form-control pull-right", id_element: '#user_id', placeholder: t(:search), type: "search", autocomplete: 'off' %>
              </div>
            <% end %>
            <script type="text/javascript" charset="utf-8">
              $('#nombre').bind('railsAutocomplete.select', function(event, data){
                $('#search-form').submit()
              });
            </script>
        </div>
      </div>
    </div>
    <div class="row">
      <% if @users.present? %>
        <div class="col-md-12">
          <div class="table-responsive">
            <table class="table table-bordered table-condensed table-striped">
              <thead>
                <tr class="thcolor">
                  <th width="13%"></th>
                  <th><%= t :username %></th>
                  <th><%= t :name %></th>
                  <th><%= t :email %></th>
                  <th class="text-center"><%= t :active %></th>
                  <th class="text-center"><%= t(:access_column_header) %></th>
                  <th class="text-center"><i class="fa fa-map-marker"></i> Last IP</th>
                </tr>
              </thead>
              <tbody>
                <% if @blockedusers != nil %>
                  <% @blockedusers.each do |user| %>
                    <tr>
                      <td class="text-center">
                        <% if user.id == 1 and isadmin == 1 %>
                          <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                          <% end %>
                          <% if user.activo == 'S' %>
                            <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:inactivate_user) do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% else %>
                            <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:activate_user) do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% end %>
                          <% if user.unlock_token %>
                            <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:unlock) do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                            <% end %>
                          <% end %>
                        <% else %>
                          <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                          <% end %>
                          <% if user.activo == 'S' %>
                            <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:inactivate_user) do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% else %>
                            <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:activate_user) do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% end %>
                          <% if user.unlock_token %>
                            <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:unlock) do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                            <% end %>
                          <% end %>
                          <%= link_to restableceyenvia_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:reset_and_send_sms) do %>
                            <button class="btn btn-xs btn-danger"><i class="fa fa-unlock"></i></button>
                          <% end %>
                        <% end %>
                      </td>
                      <td><%= user.username %></td>
                      <td><%= user.nombre %></td>
                      <td><%= user.email %></td>
                      <td class="text-center"><%= user.activo %></td>
                      <td class="text-center"><%= render 'access_cell', user: user %></td>
                      <td class="text-center" style="white-space:nowrap; font-size:12px;">
                        <% if user.current_sign_in_ip.present? %>
                          <code><%= user.current_sign_in_ip %></code>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>

                <% @users.each do |user| %>
                  <tr>
                    <td class="text-center">
                      <% if user.id == 1 and isadmin == 1 %>
                          <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                          <% end %>
                          <% if user.activo == 'S' %>
                            <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:inactivate_user) do %>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% else %>
                            <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:activate_user) do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-circle"></i></button>
                            <% end %>
                          <% end %>
                          <% if user.unlock_token %>
                            <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:unlock) do %>
                              <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                            <% end %>
                          <% end %>
                          <% if issygma %>
                            <%= link_to resetpass_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:reset_password) do %>
                              <button class="btn btn-xs btn-warning"><i class="fa fa-refresh"></i></button>
                            <% end %>
                          <% end %>
                          <%= link_to restableceyenvia_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:reset_and_send_sms) do %>
                            <button class="btn btn-xs btn-danger"><i class="fa fa-unlock"></i></button>
                          <% end %>
                      <% else %>
                        <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip' }, title: "#{t :title_editar}" do %>
                          <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                        <% end %>
                        <% if user.activo == 'S' %>
                          <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:inactivate_user) do %>
                            <button class="btn btn-xs btn-danger"><i class="fa fa-circle"></i></button>
                          <% end %>
                        <% else %>
                          <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:activate_user) do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-circle"></i></button>
                          <% end %>
                        <% end %>
                        <% if user.unlock_token %>
                          <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:unlock) do %>
                            <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                          <% end %>
                        <% end %>
                        <% if issygma %>
                          <%= link_to resetpass_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:reset_password) do %>
                            <button class="btn btn-xs btn-warning"><i class="fa fa-refresh"></i></button>
                          <% end %>
                        <% end %>
                        <%= link_to restableceyenvia_users_path(id: user.id), data: { toggle: 'tooltip', confirm: t(:seguro) }, title: t(:reset_and_send_sms) do %>
                          <button class="btn btn-xs btn-danger"><i class="fa fa-unlock"></i></button>
                        <% end %>
                      <% end %>

                          </td>
                    <td><%= user.username %></td>
                    <td><%= user.nombre %></td>
                    <td><%= user.email %></td>
                    <td class="text-center"><%= user.activo %></td>
                    <td class="text-center"><%= render 'access_cell', user: user %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="box-tools pull-right">
            <%= will_paginate @users, renderer: BootstrapPagination::Rails %>
          </div>
        </div>
      <% else %>
        <h4 class="text-center"><%= t :no_data_found %></h4>
      <% end %>
    </div>
  </div>
</div>

<div class="modal fade" id="carguemasivo">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
    </div>
  </div>
</div>