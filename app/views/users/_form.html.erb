<%= simple_form_for(@user) do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="box box-primary">
        <div class="box-header">
          <legend>
            <% if @user.unlock_token %>
              <%= link_to desbloquearusuario_users_path(id: @user.id), data: {toggle: 'tooltip', confirm: t(:seguro)}, title: t(:unlock) do %>
                <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
              <% end %>
            <% end %>
            <% if is_sygma %>
              <%= link_to resetpass_users_path(id: @user.id), data: {toggle: 'tooltip', confirm: t(:seguro)}, title: t(:reset_password) do %>
                <button class="btn btn-xs btn-warning"><i class="fa fa-refresh"></i></button>
              <% end %>
            <% end %>

            <% if @user.new_record? %>
              <%= link_to users_path, data: {toggle: 'tooltip'}, title: t(:return_to_users) do %>
                <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
              <% end %>
            <% end %>
            <%= @user.new_record? ? t(:add_new) : t(:edit) %> <%= t :user %>
          </legend>
          <div class="box-tools pull-right">
            <%= link_to new_user_path, class: 'btn btn-sm btn-info' do %>
              <i class="fa fa-plus-square"> </i> <span><%= t :new_user %></span>
            <% end %>
          </div>
        </div><!-- /.box-header -->
        <%# Solo los super-admins (id 1 y 2) pueden elegir Query Type y Client.
            El resto crea usuarios con valores por defecto: PERSONA / Bacara (id 1). %>
        <% is_super_admin = current_user && current_user.id.to_i.in?([1, 2]) %>

        <div class="box-body">
          <div class="row">
            <div class="col-md-2"><%= f.input :identificacion, label: t(:identification) %></div>
            <div class="col-md-<%= is_super_admin ? 4 : 9 %>"><%= f.input :nombre, input_html: {onChange: 'javascript:this.value=this.value.toUpperCase();', class: 'input_uppercase'} %></div>
            <div class="col-md-1"><%= f.input :activo, as: :select, collection: select_sinocorto, input_html: {class: 'select2'} %></div>

            <% if is_super_admin %>
              <div class="col-md-2"><%= f.input :tipoconsulta, as: :select, collection: select_tipoconsulta, input_html: {data: {width: '100%'}, class: 'select2', include_blank: true}, label: t(:query_type) %></div>
              <div class="col-md-3"><%= f.input :portafolio_id, collection: Portafolio.order(:nombre).collect {|p| [p.nombre, p.id]}, as: :select, input_html: {class: 'select2'}, label: t(:company), include_blank: true %></div>
            <% else %>
              <%# Defaults para no-admins: respeta valores existentes al editar %>
              <%= f.hidden_field :tipoconsulta, value: (@user.tipoconsulta.presence || 'PERSONA') %>
              <%= f.hidden_field :portafolio_id, value: (@user.portafolio_id.presence || 1) %>
            <% end %>
          </div>
          <div class="row">
            <%# Email es opcional. Si se deja en blanco, el modelo lo auto-genera
                como "<username>@bacwins.com" vía el callback set_email_from_username. %>
            <div class="col-md-3"><%= f.input :username, label: t(:username) %></div>
            <div class="col-md-3"><%= f.input :email, required: false, label: t(:email), hint: t(:email_optional_hint) %></div>
            <div class="col-md-3"><%= f.input :password, label: t(:password) %></div>
            <div class="col-md-3"><%= f.input :password_confirmation, label: t(:confirm_password) %></div>
          </div>

          <%# ── Marcación de acceso expirado sin respuesta ── %>
          <% if @user.persisted? && @user.access_expired? && !@user.extension_requested? %>
            <div class="row">
              <div class="col-md-12">
                <div class="alert alert-danger" style="margin-bottom: 10px;">
                  <i class="fa fa-exclamation-circle"></i>
                  <strong><%= t(:expired_no_response_badge) %></strong>
                  <%= t(:expired_no_response_form_hint, fecha: @user.access_expires_at.strftime('%d/%m/%Y %H:%M')) %>
                </div>
              </div>
            </div>
          <% end %>

          <%# ── Límite de acceso (solo para usuarios PERSONA) ── %>
          <% user_tipoconsulta = @user.tipoconsulta.presence || 'PERSONA' %>
          <% if user_tipoconsulta == 'PERSONA' || !is_super_admin %>
            <div class="row" id="access-expiration-row">
              <div class="col-md-4">
                <div class="form-group">
                  <label>
                    <i class="fa fa-clock-o"></i> <%= t(:access_limit_hours_label) %>
                  </label>
                  <%= f.input :access_expires_in_hours,
                        required: false,
                        label: false,
                        input_html: { class: 'form-control', placeholder: t(:access_limit_hours_placeholder) },
                        hint: @user.access_expires_at.present? ?
                              t(:access_limit_replaces_hint, fecha: @user.access_expires_at.strftime('%d/%m/%Y %H:%M')) :
                              t(:access_limit_no_limit_hint) %>
                </div>
              </div>
              <% if @user.extension_requested? %>
                <div class="col-md-4">
                  <div class="alert alert-warning" style="margin-top: 25px;">
                    <i class="fa fa-hand-paper-o"></i>
                    <strong><%= t(:access_limit_extension_warning) %></strong><br>
                    <%= t(:access_limit_extension_warning_hint) %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Si es super_admin, mostrar/ocultar el campo según tipoconsulta seleccionado %>
          <% if is_super_admin %>
            <script>
              document.addEventListener('DOMContentLoaded', function() {
                var tcSelect = document.querySelector('#user_tipoconsulta');
                var expirationRow = document.getElementById('access-expiration-row');
                if (tcSelect && expirationRow) {
                  function toggle() {
                    var v = tcSelect.value;
                    expirationRow.style.display = (v === 'PERSONA' || v === '') ? '' : 'none';
                  }
                  tcSelect.addEventListener('change', toggle);
                  toggle();
                }
              });
            </script>
          <% end %>


          <div class="row">
            <div class="col-md-3">
              <label><%= t :avatar %></label>
              <div class="avatar-preview" style="margin-bottom: 8px;">
                <%= image_tag(@user.avatar.url(:thumb),
                              alt: 'avatar',
                              style: 'width:100px; height:100px; border-radius:50%; object-fit:cover; background:#f0f0f0; border:1px solid #d8d8de;') %>
              </div>
              <%# Input nativo oculto — el botón personalizado lo activa vía JS %>
              <%= f.input :avatar, as: :file, label: false,
                    input_html: { id: 'avatar_file_input', style: 'display:none;' } %>
              <div style="display:flex; align-items:center; gap:8px; margin-top:4px;">
                <button type="button" class="btn btn-default btn-sm" onclick="document.getElementById('avatar_file_input').click();">
                  <i class="fa fa-folder-open-o"></i> <%= t(:choose_file) %>
                </button>
                <span id="avatar_file_name" style="font-size:12px; color:#777;"><%= t(:no_file_chosen) %></span>
              </div>
              <script>
                document.getElementById('avatar_file_input').addEventListener('change', function() {
                  var name = this.files.length > 0 ? this.files[0].name : '<%= j t(:no_file_chosen) %>';
                  document.getElementById('avatar_file_name').textContent = name;
                });
              </script>
            </div>
          </div>
        </div>
        <div class="box-footer">
          <div class="box-tools pull-right">
            <%= f.button :submit, t(:accept), class: 'btn-flat btn-danger' %>
          </div><!-- /.box-tools -->
        </div><!-- box-footer -->
      </div><!-- /.box -->
    </div>
  </div>
<% end %>

<%# ── Sección de documentos — form SEPARADO, fuera del simple_form_for del usuario ── %>
<% unless @user.new_record? %>
  <div class="row">
    <div class="col-md-12">
      <div class="box box-primary">
        <div class="box-body" style="border-top: 2px solid #d2d6de; padding-top: 12px;">

          <%# Encabezado + form de carga en la misma fila %>
          <%= form_for Usersdoc.new, url: user_usersdocs_path(@user),
                html: { multipart: true } do |df| %>
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
              <strong style="font-size:14px; margin-right:4px;">
                <i class="fa fa-paperclip"></i> <%= t(:usersdoc_section_title) %>
              </strong>
              <%= df.text_field :descripcion,
                    class: 'form-control input-sm',
                    placeholder: t(:usersdoc_description_placeholder),
                    style: 'width: 180px;',
                    required: true %>
              <%= df.file_field :documento, id: 'usersdoc_file_input', style: 'display:none;' %>
              <button type="button" class="btn btn-default btn-sm" onclick="document.getElementById('usersdoc_file_input').click();">
                <i class="fa fa-folder-open-o"></i> <%= t(:choose_file) %>
              </button>
              <span id="usersdoc_file_name" style="font-size:12px; color:#777;"><%= t(:no_file_chosen) %></span>
              <%= df.submit t(:usersdoc_upload_btn), class: 'btn btn-sm btn-primary' %>
            </div>
          <% end %>

          <%# Lista de documentos existentes %>
          <% if @user.usersdocs.any? %>
            <div class="table-responsive">
              <table class="table table-bordered table-condensed table-striped">
                <thead>
                  <tr class="thcolor">
                    <th><%= t(:usersdoc_description) %></th>
                    <th><%= t(:usersdoc_filename) %></th>
                    <th class="text-center"><%= t(:usersdoc_size) %></th>
                    <th class="text-center"><%= t(:usersdoc_uploaded_at) %></th>
                    <th class="text-center" width="60"></th>
                  </tr>
                </thead>
                <tbody>
                  <% @user.usersdocs.order(created_at: :desc).each do |doc| %>
                    <tr>
                      <td><%= doc.descripcion %></td>
                      <td>
                        <%= link_to doc.documento.url, target: '_blank', rel: 'noopener' do %>
                          <i class="fa fa-<%= doc.documento_content_type == 'application/pdf' ? 'file-pdf-o text-danger' : 'file-o' %>"></i>
                          <%= doc.documento_file_name %>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <% size_kb = (doc.documento_file_size.to_f / 1024).round(1) %>
                        <%= size_kb > 1024 ? "#{(size_kb / 1024).round(2)} MB" : "#{size_kb} KB" %>
                      </td>
                      <td class="text-center"><%= doc.created_at.strftime('%d/%m/%Y') %></td>
                      <td class="text-center">
                        <%= link_to user_usersdoc_path(@user, doc),
                              method: :delete,
                              data: { confirm: t(:usersdoc_confirm_delete) },
                              class: 'btn btn-xs btn-danger',
                              title: t(:usersdoc_delete) do %>
                          <i class="fa fa-trash"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted" style="font-size: 13px;">
              <i class="fa fa-info-circle"></i> <%= t(:usersdoc_none) %>
            </p>
          <% end %>

        </div><!-- /.box-body -->
      </div><!-- /.box -->
    </div>
  </div>
<% end %>

<script>
  (function() {
    var inp = document.getElementById('usersdoc_file_input');
    if (inp) {
      inp.addEventListener('change', function() {
        var lbl = document.getElementById('usersdoc_file_name');
        lbl.textContent = this.files.length > 0 ? this.files[0].name : '<%= j t(:no_file_chosen) %>';
      });
    }
  })();
</script>

