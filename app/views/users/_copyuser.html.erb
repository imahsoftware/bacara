<div class="row">
  <div class="col-md-12">
    <div class="box box-primary">
      <div class="box-body">
        <%= form_tag copyusers_users_path, method: 'get' do %>
          <%= hidden_field_tag :user_actual, @user.id %>
          <div class="box-header">
            <legend>Copia de permisos</legend>
          </div>
          <div class="box-body">
            <div class="form-group">
              <div class="row">
                <div class="col-md-6">
                  <label>Seleccione el usuario a copiar los permisos </label><br/>
                  <%= hidden_field_tag :user_id %>
                  <%= autocomplete_field_tag :nombre,'', autocomplete_user_nombre_users_path, class: "form-control pull-right", id_element: '#user_id', placeholder: t(:search_placeholder), type: "search", autocomplete: 'off' %>
                </div>
                <div class="col-md-1">
                  <%= button_tag type: 'submit', name: 'format', class: 'btn btn-primary', style: 'margin-top: 24px;', data: { toggle: 'tooltip' }, title: 'Procesar' do %>
                    <i class="fa fa-search" aria-hidden="true"></i>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

