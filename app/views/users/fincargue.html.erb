<div class="box box-primary">
  <div class="box-header">
    <legend>
      <% if is_auth_c('cargacazadores') %>
        <%= link_to descargaedupol_procesos_path, data: { toggle: 'tooltip' }, title: t(:return) do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
      <% else %>
        <%= link_to users_path, data: { toggle: 'tooltip' }, title: t(:return) do %>
          <i class="fa fa-arrow-left fa-fw text-success" aria-hidden="true"></i>
        <% end %>
      <% end %>
      <%= t :bulk_user_process %>
    </legend>
  </div>
  <div class="box-body">
    <table class="table table-bordered">
      <tr>
        <td width="30%"><strong><%= t :total_validated_records %> </strong></td>
        <td width="30%"><strong><div align="center"><%=@contotal.count%></div></strong></td>
        <td width="40%" rowspan="3"><div align="center">
          <% if @conconerror.count.to_i > 0 %>
            <%= link_to inconsistencias_users_path(userreg_id: is_admin), class: 'btn btn-sm btn-danger' do %>
              <i class="fa fa-plus-square"> </i> <span><%= t :view_inconsistencies %></span>
            <% end %>
          <% end %>
          <% if params[:carga] == 'S'%>
            <%= link_to cargar_users_path(userreg_id: is_admin), data: { disable_with: "#{t :procesando}", confirm: t(:are_you_sure_bulk_upload) }, class: 'btn btn-sm btn-warning' do %>
              <i class="fa fa-plus-square"> </i> <span><%= t :confirm_bulk_upload %></span>
            <% end %>
          <% else %>
            <%= link_to cargar2_users_path(userreg_id: is_admin), data: { disable_with: "#{t :procesando}", confirm: t(:are_you_sure_bulk_upload_inactivate) }, class: 'btn btn-sm btn-warning' do %>
              <i class="fa fa-plus-square"> </i> <span><%= t :confirm_bulk_upload %></span>
            <% end %>
          <% end %>
          </div>
        </td>
      </tr>
      <tr>
        <td><strong><%= t :total_approved_records %> </strong></td>
        <td><strong><div align="center"><%=@consinerror.count.to_i rescue 0%></div></strong></td>
      </tr>
      <tr>
        <td><strong><%= t :total_records_inconsistencies %></strong></td>
        <td><strong><div align="center"><%=@conconerror.count.to_i rescue 0%></div></strong></td>
      </tr>
    </table>
  </div>
</div>
