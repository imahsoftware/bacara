$(".alert_flash").fadeOut(1000, function() {
	$(this).remove();
});

$("#objeto_<%= @objeto.id %>").replaceWith("<%= j render 'tr', objeto: @objeto %>");

$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
	$(".alert_flash").fadeOut(1000, function() {
		$(this).remove();
	});
}, 5000);
