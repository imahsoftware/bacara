<% if @active_record.present? %>
	$("#objeto_<%= @active_record.id %>").replaceWith("<%= j render 'tr', objeto: @active_record %>");
<% end %>
$("#objeto_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#objeto_form").collapse("show");
$(".select2").select2();
