<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr class="thcolor">
        <th class="text-center"><%= t :actions %></th>
        <th><%= t :description %></th>
        <th><%= t :extended_description %></th>
        <th><%= t :authorized %></th>
      </tr>
    </thead>
    <tbody id="tbody_objetos">
      <% @objetos.order(created_at: :desc).each do |objeto| %>
	      <%= render 'objetos/tr', objeto: objeto %>
	    <% end %>
    </tbody>
  </table>
</div>
<div class="box-footer clear-fix">
  <div class="box-tools pull-right">
    <%= will_paginate @objetos, renderer: BootstrapPagination::Rails %>
  </div>
</div><!-- box-footer -->
