<% if @active_record.present? %>
	$("#usersmodulo_<%= @active_record.id %>").replaceWith("<%= j render 'tr', usersmodulo: @active_record %>");
<% end %>
$("#usersmodulo_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#usersmodulo_form").collapse("show");
$(".select2").select2();
