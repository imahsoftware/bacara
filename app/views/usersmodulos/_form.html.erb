<%= simple_form_for([@user, @usersmodulo], remote: true) do |f| %>
   <div class="row">
    <div class="col-md-12"><%= f.input :modulo_id, collection: Modulo.where(["id not in (select modulo_id from usersmodulos where user_id = #{@user.id})"]).collect {|p| [ p.descripcion.to_s + ' ('+p.mensaje.to_s+')', p.id ] }, input_html: { multiple: true, class: 'select2' }, label: t('modulo') %></div>
   </div>
   <div class="row">
     <div class="col-md-6">
       <% if @usersmodulo.new_record? %>
         <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#usersmodulo_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
       <% else %>
         <%= link_to "#{t :cancelar}", user_usersmodulo_path(@user, @usersmodulo), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
       <% end %>
     </div>
     <div class="col-md-6">
       <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
     </div>
   </div>
   <br>
<% end %>
