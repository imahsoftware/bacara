<%= simple_form_for @portafolio, html: { class: 'form-horizontal'}, wrapper: :horizontal_form, remote: true do |f| %>
  <div class="form-inputs">

    </div>
  </div>

  <div class="form-actions">
    <div class="box-tools">
      <div class="col-md-10">
        <%= f.button :submit, "#{t :guardar}", class: 'btn btn-flat btn-primary' %>
      </div>
    </div>
    <div class="col-md-2">
      <%= button_tag "#{t :cancelar}", type: 'button', data: { disable_with: "#{t :procesando}"}, class: 'btn btn-default', id: 'cancelar-form-ob' %>
    </div>

  </div>
<% end %>



<%= simple_form_for(@portafolio) do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="box box-primary">
        <div class="box-header with-border">
          <h3 class="box-title"><strong><%= user.new_record? ? t(:add_new) : t(:edit) %> <%= t :user %></strong></h3>
        </div><!-- /.box-header -->
        <div class="box-body">
          <div class="row">
            <div class="col-md-4"><%= f.input :nombre %></div>
            <div class="col-md-4"><%= f.input :email %></div>
            <div class="col-md-4"><%= f.input :password %></div>
         </div>
         <div class="row">
            <div class="col-md-6"><%= f.input :cargo %></div>
         </div>
        </div>
        <div class="box-footer">
          <%= link_to "#{t :cancelar}", users_path, class: 'btn btn-flat btn-default' %>
          <div class="box-tools pull-right">
            <%= f.button :submit, t(:accept), class: 'btn-flat btn-primary' %>
          </div><!-- /.box-tools -->
        </div><!-- box-footer -->
      </div><!-- /.box -->
    </div>
  </div>
<% end %>
