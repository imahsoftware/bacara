<div class="box box-primary">
  <%= simple_form_for(@portafolio) do |f| %>

    <div class="box-header">
      <legend>
        <% if @portafolio.new_record? %>
          <%= link_to portafolios_path, data: { toggle: 'tooltip' }, title: t(:return_to_portfolios) do %>
            <i class="fa fa-arrow-left fa-fw text-danger" aria-hidden="true"></i>
          <% end %>
        <% end %>
        <%= @portafolio.new_record? ? t(:new_company) : t(:edit_company) %>
      </legend>
      <% unless @portafolio.new_record? %>
        <div class="box-tools pull-right">
          <span class="label label-danger">
            <%= t :creation_date %>: <%= @portafolio.created_at.strftime("%Y-%m-%d %X") rescue nil %>
          </span>
        </div>
      <% end %>
    </div><!-- /.box-header -->

    <div class="box-body">
      <div class="row">
        <div class="col-md-6">
          <%= f.input :identificacion, label: t(:identificacion) %>
        </div>
        <div class="col-md-6">
          <%= f.input :email, label: t(:correo_electronico) %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <%= f.input :username, label: t(:username) %>
        </div>
        <div class="col-md-6">
          <%= f.input :clave, label: t(:clave) %>
        </div>
      </div>
    </div><!-- /.box-body -->

    <div class="box-footer">
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: 'btn btn-danger' %>
      </div>
    </div><!-- /.box-footer -->

  <% end %>
</div>
