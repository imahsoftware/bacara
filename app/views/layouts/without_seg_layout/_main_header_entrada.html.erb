<%
  isadmin = is_admin
  usr = User.find(isadmin)
  isportafolio = is_portafolio
  issygma = is_sygma
%>
  <header class="main-header">

<!-- Logo -->
<%= link_to root_path, class: 'logo'  do %>
  <%= render "shared/header_brand_with_image" %>
  <%= link_to logout_path, data: { confirm: '¿Esta seguro ' + "#{usr.nombre}" + ' que quiere desconectarse?' } do %>
    <button class="btn btn-flat btn-default"><i class="fa fa-sign-in"> <b>Salir</b></i></button>
  <% end %>
<% end %>

<!-- Header Navbar -->
<nav class="navbar navbar-static-top hidden-xs hidden-sm" role="navigation">

</nav>
</header>
<style>
  .bor{border-radius: 10px !important;}
  .main-header .logo {
    text-align: left;
  }
  .main-header #navbar-search-input.form-control {
    background: rgba(255,255,255,0.9) !important;
    border-color: transparent !important;
  }
  .input-group-btn:last-child > .btn, .input-group-btn:last-child > .btn-group {
    z-index: -2;
    margin-left: 0px !important;
  }
</style>
