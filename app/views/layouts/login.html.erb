<!DOCTYPE html>
<html>
  <head>
    <title><%= app_brand_name %></title>
    <meta name="description" content="BacWins — acceso seguro en bacwins.bot" />
    <meta name="theme-color" content="#06176B" />
    <%= csrf_meta_tags %>

    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <%= stylesheet_link_tag    'application', media: 'all'%>
    <%= javascript_include_tag 'application'%>
  </head>

  <body class="hold-transition"style="background-color: #EAEAEA;">
    <%= yield %>
  </body>
</html>
