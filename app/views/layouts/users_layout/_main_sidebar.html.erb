<aside class="main-sidebar">
  <section class="sidebar">
    <ul class="sidebar-menu" data-widget="tree">
      <li>
        <%= link_to users_path do %>
          <i class="fa fa-arrow-left text-success"></i> <%= t :regresar_usuarios %>
        <% end %>
      </li>
      <li class="header"><%=t :menu%></li>
      <li class="<%= active_class(edit_user_path(etapa: "A", id: @user.id)) %>">
        <%= link_to edit_user_path(etapa: "A", id: @user.id) do %>
          <i class="fa fa-bullseye"></i> <span><%= t :datos_basicos %></span>
        <% end %>
      </li>
      <% if is_auth_c('botonesusuarios') %>
        <li class="<%= active_class(edit_user_path(etapa: "B", id: @user.id)) %>">
          <%= link_to edit_user_path(etapa: "B", id: @user.id) do %>
            <i class="fa fa-bullseye"></i> <span><%= t :modulos %></span>
          <% end %>
        </li>
        <li class="<%= active_class(edit_user_path(etapa: "C", id: @user.id)) %>">
          <%= link_to edit_user_path(etapa: "C", id: @user.id) do %>
            <i class="fa fa-bullseye"></i> <span><%= t :permisos %></span>
          <% end %>
        </li>
        <li class="<%= active_class(edit_user_path(etapa: "I", id: @user.id)) %>">
          <%= link_to edit_user_path(etapa: "I", id: @user.id) do %>
            <i class="fa fa-bullseye"></i> <span><%= t :reportes %></span>
          <% end %>
        </li>
        <li class="<%= active_class(edit_user_path(etapa: "K", id: @user.id)) %>">
          <%= link_to edit_user_path(etapa: "K", id: @user.id) do %>
            <i class="fa fa-bullseye"></i> <span><%= t :parametros %></span>
          <% end %>
        </li>
        <li class="<%= active_class(edit_user_path(etapa: "L", id: @user.id)) %>">
          <%= link_to edit_user_path(etapa: "L", id: @user.id) do %>
            <i class="fa fa-bullseye"></i> <span>Connections</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</aside>
