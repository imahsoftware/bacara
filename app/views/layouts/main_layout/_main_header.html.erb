<%
  isadmin = is_admin
  user = User.find(isadmin)
  isportafolio = is_portafolio
  isimah = is_sygma
%>
<header class="main-header">
  <% permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists? %>
  <%= link_to root_path, class: 'logo', style: "back" do %>
    <%= render "shared/header_brand_wordmark" %>
  <% end %>

  <!-- Header Navbar: style can be found in header.less -->
  <nav class="navbar navbar-static-top">
    <% unless is_persona %>
    <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
      <span class="sr-only">Toggle navigation</span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </a>
    <% end %>
    <div class="navbar-custom-menu">
      <ul class="nav navbar-nav">
        <li class="dropdown user user-menu">
          <%= link_to '#', class: 'dropdown-toggle', data: { toggle: 'dropdown' } do %>
            <%= image_tag user.avatar.url(:medium), class: 'user-image', alt: 'User Image' %>
            <span class="hidden-xs"><%= user.username %></span>
          <% end %>
          <ul class="dropdown-menu">
            <li class="user-header">
              <%= image_tag user.avatar.url(:medium), class: 'img-circle', alt: 'User Image' %>
              <p style="font-size: 11px;">
                <%= user.nombre %>
              </p>
            </li>
            <li class="user-footer">
              <div class="pull-left">
                <%= link_to edit_user_registration_path do %>
                  <button class="btn btn-flat btn-default">
                    <i class="fa fa-edit"> <b style="font-size: 11px;"><%= t :editar_perfil %></b></i></button>
                <% end %>
              </div>
              <div class="pull-right">
                <%= link_to logout_path, data: { confirm: t('are_you_sure_logout') + ' ' + "#{user.nombre}" + ' ' + t('that_you_want_to_disconnect') + '?' } do %>
                  <button class="btn btn-flat btn-default">
                    <i class="fa fa-sign-in"> <b style="font-size: 11px;"><%= t :salir %></b></i></button>
                <% end %>
              </div>
            </li>
          </ul>
        </li>
      </ul>
    </div>

    <div class="navbar-collapse collapse" id="navbar-collapse" aria-expanded="false" style="background-color: #000000;">
      <!-- Navbar Right Menu -->
      <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
          <li class="dropdown messages-menu">
            <div class="navbar-custom-menu">
              <ul class="nav navbar-nav">
                <%
                  permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists?
                %>
                <% if params[:controller].to_s != 'users' %>
                  <% if current_user.user2_id.to_s != "" %>
                    <ul class="nav navbar-nav">
                      <li>
                        <%= link_to reestablecesusuario_users_path do %>
                          <span style="font-size: 12px !important; "><%= t('reestablish') %></span>

                        <% end %>
                      </li>
                    </ul>
                  <% end %>
                <% end %>
                <% if isimah or permit == true %>
                  <% if params[:controller].to_s != 'users' %>
                    <li class="dropdown messages-menu">
                      <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <span class="glyphicon glyphicon-search"></span>
                      </a>
                      <ul class="dropdown-menu" style="margin-top: 3px;">
                        <li>
                          <% if isimah == true and current_user.user2_id.to_s == "" %>
                            <%= form_tag cambiousuario_users_path, method: :get, id: "search-form", class: 'navbar-form navbar-left', role: 'search' do %>
                              <%= hidden_field_tag :user_id %>
                              <div class="input-group">
                                <%= autocomplete_field_tag :nombre, '', autocomplete_cambio_user2_users_path(portafolio_id: isportafolio), class: "form-control", id: 'navbar-search-input', id_element: '#user_id', placeholder: t('buscar'), type: "search" %>
                              </div>
                            <% end %>
                            <script type="text/javascript" charset="utf-8">
                                $('#navbar-search-input').bind('railsAutocomplete.select', function (event, data) {
                                    $('#search-form').submit()
                                });
                            </script>
                          <% end %>

                        </li>
                      </ul>
                    </li>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </li>

          <%# ── Badge de solicitudes de extensión (solo admins) ── %>
          <% if isimah || permit == true %>
            <% pendientes_count = (User.where(tipoconsulta: 'PERSONA', extension_requested: true).count +
                                   User.where(tipoconsulta: 'PERSONA', extension_requested: false).where('access_expires_at IS NOT NULL AND access_expires_at < ?', Time.current).count) rescue 0 %>
            <% if pendientes_count > 0 %>
              <li style="position: relative;">
                <%= link_to pendientes_extension_users_path,
                      style: 'padding: 10px 12px; display: block; position: relative;',
                      title: t(:extension_requests_pending_badge_title),
                      data: { toggle: 'tooltip' } do %>
                  <i class="fa fa-clock-o" style="font-size: 16px; color: #fff;"></i>
                  <span style="position: absolute; top: 4px; right: 2px; background:#c0392b; color:#fff; border-radius: 50%; font-size: 10px; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; font-weight: bold;"><%= pendientes_count %></span>
                <% end %>
              </li>
            <% end %>
          <% end %>

          <% if isimah or permit == true
               @modulosseguridad = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).select("modulos.*").order("modulos.descripcion")
               parcount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).count
          %>
            <li class="dropdown messages-menu">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                <i class="fa fa-th-list"></i>
                <span class="label label-danger"><%= parcount rescue 0 %></span>
              </a>
              <ul class="dropdown-menu" style="width: 360px; margin-top: 3px;">
                <section class="content-header">
                  <h1>
                    <i class="fa fa-th-list"></i>
                    <small><%= t('administration_modules') %></small>
                  </h1>
                  <ol class="breadcrumb">
                    <li class="header">
                      <%= link_to menu_menus_path, remote: true, data: { toggle: 'tooltip' }, title: t('expand_security_modules') do %>
                        <i class="fa fa-arrows-h"></i>
                      <% end %>
                    </li>
                  </ol>
                </section>
                <br/>
                <li>
                  <ul class="menu">
                    <% @modulosseguridad.each do |item| %>
                      <% if item.metodo.to_s == "" %>
                        <% item.metodo = 'GET' %>
                      <% end %>
                      <%
                        label = case item.controlador
                                when "/modulos"      then "Modules"
                                when "/objetos"      then "Objects"
                                when "/portafolios"  then "Clients"
                                when "/admin/users"  then "Users"
                                else item.controlador
                                end
                      %>
                      <li>
                        <%= link_to item.controlador, class: 'a-control-sidebar' do %>
                          <div class="pull-left">
                            <i class="<%= item.imagen.blank? ? 'fa fa-link' : item.imagen %>" style="font-size: 25px; color: #000;"></i>
                          </div>
                          <h4><%= label %></h4>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </li>
              </ul>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>

<%# ── Banner de tiempo límite de acceso con botones de acción ── %>
<% if user.persona_con_limite? && !user.access_expired? %>
  <div id="access-expiration-banner" style="background-color: #c0392b; color: #fff; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
    <div style="font-size: 14px; font-weight: bold;">
      <i class="fa fa-clock-o"></i>
      <%= t(:access_expiration_banner) %> <span id="expiration-countdown" style="font-size: 16px;"><%= user.tiempo_restante %></span>
    </div>

    <% if user.extension_requested? %>
      <%# Ya solicitó continuar — solo muestra confirmación %>
      <div style="font-size: 13px; background: rgba(0,0,0,0.2); padding: 6px 14px; border-radius: 4px;">
        <i class="fa fa-check-circle"></i> <%= t(:access_expired_extension_requested) %>
      </div>
    <% else %>
      <%# Aún no ha respondido — muestra los dos botones %>
      <div style="display: flex; gap: 10px; align-items: center;">
        <%= form_tag solicitar_extension_access_expired_index_path, method: :post, style: "margin:0;" do %>
          <%= submit_tag t(:access_expired_yes),
                class: "btn btn-sm btn-success",
                data: { confirm: t(:access_expired_confirm_yes) } %>
        <% end %>
        <%= form_tag rechazar_acceso_access_expired_index_path, method: :post, style: "margin:0;" do %>
          <%= submit_tag t(:access_expired_no),
                class: "btn btn-sm btn-default" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <script>
    (function() {
      var expiresAt = new Date(<%= user.access_expires_at.to_i * 1000 %>);
      function updateCountdown() {
        var now = new Date();
        var diff = Math.floor((expiresAt - now) / 1000);
        if (diff <= 0) {
          // Tiempo agotado: redirigir a la pantalla de acceso denegado
          window.location.href = '<%= access_expired_index_path %>';
          clearInterval(timer);
          return;
        }
        var h = Math.floor(diff / 3600);
        var m = Math.floor((diff % 3600) / 60);
        var s = diff % 60;
        var parts = [];
        if (h > 0) parts.push(h + 'h');
        if (m > 0 || h > 0) parts.push(m + 'm');
        parts.push(s + 's');
        var el = document.getElementById('expiration-countdown');
        if (el) el.textContent = parts.join(' ');
      }
      var timer = setInterval(updateCountdown, 1000);
      updateCountdown();
    })();
  </script>
<% end %>


<style>
    .main-header .logo {
        background-color: #fff !important;
        color: #06176B !important;
        height: 43px !important;
    }

    .navbar-nav > li > a {
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        height: 47px;
    }

    .main-header .navbar {
        -webkit-transition: margin-left .3s ease-in-out !important;
        -o-transition: margin-left .3s ease-in-out !important;
        transition: margin-left .3s ease-in-out !important;
        margin-bottom: 0 !important;
        border: none !important;
        min-height: 43px !important;
        border-radius: 0 !important;
    }

</style>











