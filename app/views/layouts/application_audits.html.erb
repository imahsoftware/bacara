<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : 'Registros' %> | <%= ENV['NOMBRE_APLICACION'] %></title>
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <%= stylesheet_link_tag    'application', media: 'all'%>
    <%= javascript_include_tag 'application'%>
  </head>
  <body class="sidebar-mini skin-blue-light">
    <div class="wrapper">
      <%= render 'layouts/main_layout/main_header' %>
      <%= render 'layouts/audits_layout/main_sidebar' %>
      <%= render 'layouts/audits_layout/main_content' %>
      <%= render 'layouts/main_layout/main_footer' %>
      <%#= render 'layouts/main_layout/control_sidebar' %>
    </div>
  </body>
</html>
