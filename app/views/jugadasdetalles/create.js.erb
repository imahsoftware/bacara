// app/views/jugadasdetalles/create.js.erb

$('#tabla-movimientos').html('<%= j render("tabla_movimientos", jugadasdetalles: @jugadasdetalles || [], nuevo_detalle: @nuevo_detalle) %>');
$('#mov-count').text('<%= @total_movimientos %>');
$('#badge-count').text('<%= @total_movimientos %>');
$('#next-bet-text').text('<%= j @proximo_bet %>');

<% if @total_movimientos > 5 %>
$('#prc-badge').show();
<% else %>
$('#prc-badge').hide();
<% end %>

// ═══ Reiniciar floating header + auto-scroll ═══
(function(){
    if (typeof window.setupFloatingHeader === 'function') {
        window.setupFloatingHeader();
    }

    var el = document.getElementById('jd-movimientos-scroll');
    if (el) {
        setTimeout(function(){
            // Scroll interno del contenedor (escritorio)
            el.scrollTop = el.scrollHeight;

            // En mobile/tablet el layout es una columna y la página hace scroll
            // Si el div no tiene scroll propio, desplazar la ventana hasta el final de la tabla
            if (el.scrollHeight <= el.clientHeight) {
                var tablaEl = document.getElementById('tabla-movimientos');
                if (tablaEl) {
                    tablaEl.lastElementChild && tablaEl.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'end' });
                }
            }
        }, 80);
    }
})();

