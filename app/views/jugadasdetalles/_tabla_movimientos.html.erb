<%# app/views/jugadasdetalles/_tabla_movimientos.html.erb %>

<% if jugadasdetalles.empty? %>
  <div class="jd-empty">
    <i class="fa fa-inbox"></i>
    Aún no hay movimientos. Haz clic en <strong>P</strong> o <strong>B</strong> para comenzar.
  </div>

<% else %>

  <div style="overflow-x:auto;">
    <table class="bac-table">
      <thead>
      <%# ── Fila 1: Grupos ──────────────────────────────────────── %>
      <tr class="tr-grupos">
        <th rowspan="2" style="background:#f8fafc; color:#374151; width:32px;">#</th>

        <%# Bloque 1 %>
        <th colspan="4" class="th-grupo-1">
          <i class="fa fa-play-circle"></i> Jugada 1
        </th>

        <%# Central P | B %>
        <th colspan="2" class="th-grupo-central">P &nbsp;|&nbsp; B</th>

        <%# Bloque 2 %>
        <th colspan="4" class="th-grupo-2">
          <i class="fa fa-play-circle"></i> Jugada 2
        </th>

        <%# Resultado final %>
        <th colspan="3" class="th-grupo-res">
          <i class="fa fa-flag-checkered"></i> Resultado
        </th>
      </tr>

      <%# ── Fila 2: Columnas individuales ──────────────────────── %>
      <tr class="tr-cols">
        <%# Bloque 1 %>
        <th>MEC</th>
        <th class="col-p-head">P</th>
        <th class="col-b-head">B</th>
        <th>✓/✗</th>

        <%# Central %>
        <th class="col-p-head sep-left">P</th>
        <th class="col-b-head sep-right">B</th>

        <%# Bloque 2 %>
        <th>MEC</th>
        <th class="col-p-head">P</th>
        <th class="col-b-head">B</th>
        <th>✓/✗</th>

        <%# Resultado %>
        <th>RES</th>
        <th>Final</th>
        <th>Acum.</th>
      </tr>
      </thead>

      <tbody>
      <% jugadasdetalles.each_with_index do |d, i| %>
        <tr id="row-<%= d.id %>"
            class="<%= 'jd-row-new' if defined?(nuevo_detalle) && nuevo_detalle&.id == d.id %>">

          <%# Número de fila %>
          <td class="td-num"><%= i + 1 %></td>

          <%# ── BLOQUE 1 ─────────────────────────────────────────── %>
          <td><%= d.mecanica1.presence || '—' %></td>

          <td>
            <% if d.player1.present? %>
              <span class="bac-pos"><%= d.player1 %></span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td>
            <% if d.banquer1.present? %>
              <span class="bac-neg"><%= d.banquer1 %></span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td>
            <% if d.resultado1 == 1 %>
              <span class="bac-ok">✓</span>
            <% elsif d.resultado1 == 0 %>
              <span class="bac-no">✗</span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <%# ── COLUMNA CENTRAL P | B (r_player / r_banker) ──────── %>
          <td class="td-central-p">
            <% if d.r_player == 1 %>
              <span class="bac-chip bac-chip-p">P</span>
            <% else %>
              <span class="bac-chip bac-chip-none">–</span>
            <% end %>
          </td>

          <td class="td-central-b">
            <% if d.r_banker == 1 %>
              <span class="bac-chip bac-chip-b">B</span>
            <% else %>
              <span class="bac-chip bac-chip-none">–</span>
            <% end %>
          </td>

          <%# ── BLOQUE 2 ─────────────────────────────────────────── %>
          <td><%= d.mecanica2.presence || '—' %></td>

          <td>
            <% if d.player2.present? %>
              <span class="bac-pos"><%= d.player2 %></span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td>
            <% if d.banquer2.present? %>
              <span class="bac-neg"><%= d.banquer2 %></span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td>
            <% if d.resultado2 == 1 %>
              <span class="bac-ok">✓</span>
            <% elsif d.resultado2 == 0 %>
              <span class="bac-no">✗</span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <%# ── RESULTADO FINAL ──────────────────────────────────── %>
          <td>
            <% if d.mensaje.present? %>
              <span style="font-size:11px; color:#374151;"><%= d.mensaje %></span>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td class="td-final">
            <% if d.final.present? %>
              <% if d.final > 0 %>
                <span class="bac-pos">+<%= d.final %></span>
              <% elsif d.final < 0 %>
                <span class="bac-neg"><%= d.final %></span>
              <% else %>
                <span class="bac-zero">0</span>
              <% end %>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

          <td class="<%= d.acumulado.present? ? (d.acumulado > 0 ? 'td-acum-pos' : d.acumulado < 0 ? 'td-acum-neg' : 'td-acum-zer') : '' %>">
            <% if d.acumulado.present? %>
              <% if d.acumulado > 0 %>
                +<%= d.acumulado %>
              <% else %>
                <%= d.acumulado %>
              <% end %>
            <% else %>
              <span class="bac-dash">—</span>
            <% end %>
          </td>

        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% end %>
