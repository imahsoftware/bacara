<%# Profit = sumatoria de acumuladof por jugada_id en jugadasdetalles %>
<% jd_profit_display = Jugadasdetalle.formatted_profit_for_jugada(@jugada_id) %>
<% jd_pendiente = @jugada.estado.to_s.upcase == 'PENDIENTE' %>
<% jd_muestra_regresar = current_user.tipoconsulta.to_s != 'PERSONA' %>
<% jd_muestra_new_shoe = current_user.tipoconsulta.to_s == 'PERSONA' && @jugada.present? && @jugada.estado.to_s.upcase == 'CERRADA' %>

<input type="hidden" id="jd-base-bet" value="10" />

<div id="jd-spinner">⏳ <%= t(:guardando) %></div>

<div class="jd-bw-page">
  <div class="jd-bw-main">
    <aside class="jd-bw-sidebar">
      <header class="jd-bw-hero">
        <h1 class="jd-bw-title"><%= t(:baccarat_winners) %></h1>
        <p class="jd-bw-profit">
          <span class="jd-bw-profit__label"><%= t(:profit_label) %></span>
          <span class="jd-bw-profit__wrap">
            <span class="jd-bw-profit__currency" title="<%= t(:usd_title) %>">US</span><span id="jd-profit-amount"><%= jd_profit_display %></span>
          </span>
        </p>
      </header>

      <div class="jd-next-bet jd-next-bet--bw" id="jd-next-bet-banner">
        <span class="jd-nb-label"><%= t(:your_next_bet) %>:</span>
        <p class="jd-next-bet__value" id="next-bet-text"><%= @proximo_bet %></p>
      </div>

      <div class="jd-bw-actions">
        <% if jd_pendiente %>
        <div class="jd-circles jd-circles--bw">
          <button class="jd-circle jd-circle-p jd-circle--bw" id="btn-player"
                  data-tipo="P" data-jugada-id="<%= @jugada_id %>" title="Player">P
          </button>
          <button class="jd-circle jd-circle-b jd-circle--bw" id="btn-banker"
                  data-tipo="B" data-jugada-id="<%= @jugada_id %>" title="Banker">B
          </button>
        </div>
        <% end %>

        <div class="jd-bw-row-btns">
          <% if jd_pendiente %>
          <button type="button" class="jd-undo-btn jd-undo-btn--bw" id="btn-undo"
                  data-jugada-id="<%= @jugada_id %>"
                  data-label-default="<%= t(:undo_last_hand) %>"
                  data-label-loading="<%= t(:undoing) %>">
            <%= t(:undo_last_hand) %>
          </button>
          <button type="button" class="jd-reset-btn" id="btn-reset"
                  data-jugada-id="<%= @jugada_id %>"
                  data-label-default="<%= t(:clear_session) %>"
                  data-label-loading="<%= t(:clearing) %>">
            <%= t(:clear_session) %>
          </button>
          <% end %>
          <% if jd_muestra_regresar %>
            <%= link_to t(:regresar), jugadas_path, class: 'jd-back-btn' %>
          <% elsif jd_muestra_new_shoe %>
            <%# tipoconsulta PERSONA y jugada CERRADA: SHOE#id, solo si from_jugada CERRADA (ver controller) %>
            <%= link_to nueva_shoe_jugada_path(from_jugada_id: @jugada_id), method: :post, class: 'btn btn-success btn-block' do %>
              <i class="fa fa-plus" aria-hidden="true"></i> <%= t(:new_shoe) %>
            <% end %>
          <% end %>
        </div>
      </div>

      <footer class="jd-bw-foot jd-bw-foot--sidebar">
        <span id="mov-count" style="display:none;"><%= @total_movimientos %></span>
        <span id="prc-badge" style="display:none;"></span>
      </footer>
    </aside>

    <div class="jd-bw-col-table">
      <section class="jd-bw-frequency">
        <div class="jd-bw-frequency-head">
          <h2 class="jd-bw-ft-title">
            <%= t(:frequency_table) %>
            <span class="jd-badge jd-badge--ft" id="badge-count"><%= @total_movimientos %></span>
          </h2>
          <% if @jugada.present? %>
            <p class="jd-bw-sub--ft"><%= t(:play_number) %> #<%= @jugada_id %></p>
          <% end %>
        </div>

        <div id="jd-movimientos-scroll" class="jd-movimientos-scroll--bw">
          <div id="jd-floating-header" class="jd-floating-header jd-floating-header--bw" style="display:none;"></div>
          <div id="tabla-movimientos">
            <%= render 'tabla_movimientos', jugadasdetalles: @jugadasdetalles %>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
    $(function(){
        function syncMovimientosHeight(){
            var $scroll = $('#jd-movimientos-scroll');
            if (!$scroll.length) return;
            var rect = $scroll[0].getBoundingClientRect();
            var viewportH = window.innerHeight || document.documentElement.clientHeight || 0;
            var bottomGap = 80; // +10px para separar contenedor del borde inferior
            // Si usuario ya scrolleo página y top queda negativo,
            // usar 0 para no inflar altura del contenedor.
            var visibleTop = Math.max(rect.top, 0);
            var available = Math.floor(viewportH - visibleTop - bottomGap);
            var target = Math.max(180, available);

            $scroll.css({
                height: target + 'px',
                maxHeight: target + 'px'
            });
        }

        // ═══ Floating header: clona encabezados y mantiene anchos reales al scrollear ═══
        function setupFloatingHeader(){
            var $scroll = $('#jd-movimientos-scroll');
            var $float  = $('#jd-floating-header');
            if (!$scroll.length || !$float.length) return;

            // Buscar encabezados y contenedores originales
            var $leftTable   = $scroll.find('.bac-scorecard-left table').first();
            var $rightTable  = $scroll.find('.bac-scorecard-right table').first();
            var $centerTable = $scroll.find('.bac-table-central-top').first();
            var $leftThead   = $leftTable.find('thead').first();
            var $rightThead  = $rightTable.find('thead').first();
            var $centerThead = $centerTable.find('thead').first();
            var $centerCol   = $scroll.find('.bac-scorecard-center').first();
            var $grid        = $scroll.find('.bac-scorecard-grid').first();

            // Si no hay headers principales (menos de 6 registros), no hacer nada
            if (!$leftThead.length || !$rightThead.length || !$centerThead.length) {
                $scroll.off('.floatingHeader');
                $(window).off('.floatingHeader');
                $float.hide();
                return;
            }

            // Construir header clonado
            var html = ''
                + '<div class="jd-floating-grid">'
                +   '<div class="jd-floating-col jd-floating-col-left"><table class="bac-table"><thead>' + $leftThead.html() + '</thead></table></div>'
                +   '<div class="jd-floating-col jd-floating-col-center"><table class="bac-table bac-table-central-top"><thead>' + $centerThead.html() + '</thead></table></div>'
                +   '<div class="jd-floating-col jd-floating-col-right"><table class="bac-table"><thead>' + $rightThead.html() + '</thead></table></div>'
                + '</div>';
            $float.html(html);

            function syncFloatingSizes(){
                var leftW = Math.round($leftTable.outerWidth() || 0);
                var centerW = Math.round(($centerCol.outerWidth() || $centerTable.outerWidth() || 0));
                var rightW = Math.round($rightTable.outerWidth() || 0);
                var totalW = Math.max(
                    Math.round($grid.outerWidth() || 0),
                    leftW + centerW + rightW
                );

                var $fg = $float.find('.jd-floating-grid');
                $fg.css({
                    display: 'grid',
                    gridTemplateColumns: leftW + 'px ' + centerW + 'px ' + rightW + 'px',
                    minWidth: totalW + 'px',
                    width: totalW + 'px'
                });

                var $fLeft  = $float.find('.jd-floating-col-left table');
                var $fCtr   = $float.find('.jd-floating-col-center table');
                var $fRight = $float.find('.jd-floating-col-right table');

                $fLeft.css('width', leftW + 'px');
                $fCtr.css('width', centerW + 'px');
                $fRight.css('width', rightW + 'px');

                $float[0].scrollLeft = $scroll[0].scrollLeft;
            }

            $scroll.off('scroll.floatingHeader').on('scroll.floatingHeader', function(){
                var showFloating = $scroll.scrollTop() > ($leftThead.outerHeight() || 0);
                if (showFloating) {
                    $float.show();
                    $scroll.addClass('jd-floating-active');
                } else {
                    $float.hide();
                    $scroll.removeClass('jd-floating-active');
                }
                if ($float.is(':visible')) {
                    $float[0].scrollLeft = $scroll[0].scrollLeft;
                }
            });

            // Forzar rueda dentro de tabla al scroll interno (evita mover página)
            $scroll.off('wheel.tableScroll').on('wheel.tableScroll', function(e){
                var ev = e.originalEvent;
                if (!ev) return;
                e.preventDefault();
                this.scrollTop += ev.deltaY;
                this.scrollLeft += ev.deltaX;
            });

            $(window).off('resize.floatingHeader').on('resize.floatingHeader', function(){
                syncFloatingSizes();
            });

            // Si rueda cae sobre cabecera flotante, mover scroll de tabla
            $float.off('wheel.floatingHeader').on('wheel.floatingHeader', function(e){
                var ev = e.originalEvent;
                if (!ev) return;
                e.preventDefault();
                $scroll[0].scrollTop += ev.deltaY;
                $scroll[0].scrollLeft += ev.deltaX;
            });

            syncFloatingSizes();
            $scroll.trigger('scroll.floatingHeader');
        }

        syncMovimientosHeight();
        setupFloatingHeader();
        $(window).off('resize.jdLayout').on('resize.jdLayout', function(){
            syncMovimientosHeight();
            if (window.setupFloatingHeader) window.setupFloatingHeader();
        });

        // Exponer para que los JS de create/undo puedan reinicializar
        window.setupFloatingHeader = setupFloatingHeader;
        window.syncMovimientosHeight = syncMovimientosHeight;

        // Auto-scroll al último registro
        var $scroll = $('#jd-movimientos-scroll');
        if ($scroll.length && $scroll[0].scrollHeight > $scroll[0].clientHeight) {
            setTimeout(function(){ $scroll.scrollTop($scroll[0].scrollHeight); }, 100);
        }
    });
</script>
