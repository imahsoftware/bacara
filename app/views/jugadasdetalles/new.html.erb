<%# Profit = sumatoria de acumuladof por jugada_id en jugadasdetalles %>
<% jd_profit_display = Jugadasdetalle.formatted_profit_for_jugada(@jugada_id) %>
<% jd_is_persona = current_user.tipoconsulta.to_s == 'PERSONA' %>
<% jd_finalizada = @jugada.estado.to_s.upcase == 'FINALIZADA' %>

<input type="hidden" id="jd-base-bet" value="10" />

<div id="jd-spinner">⏳ Guardando...</div>

<div class="jd-bw-page <%= 'jd-bw-page--persona' if jd_is_persona %>">
  <div class="jd-bw-main <%= 'jd-bw-main--persona' if jd_is_persona %>">
    <aside class="jd-bw-sidebar">
      <header class="jd-bw-hero">
        <h1 class="jd-bw-title">Baccarat Winners</h1>
        <p class="jd-bw-profit">PROFIT: $<span id="jd-profit-amount"><%= jd_profit_display %></span></p>
        <% if @jugada.present? %>
          <p class="jd-bw-sub"><%= @jugada.jugador %> · Jugada #<%= @jugada_id %></p>
        <% end %>
      </header>

      <div class="jd-next-bet jd-next-bet--bw" id="jd-next-bet-banner">
        <span class="jd-nb-label">Your Next Bet:</span>
        <p id="next-bet-text"><%= @proximo_bet %></p>
      </div>

      <div class="jd-bw-actions">
        <div class="jd-circles jd-circles--bw">
          <button class="jd-circle jd-circle-p jd-circle--bw" id="btn-player"
                  data-tipo="P" data-jugada-id="<%= @jugada_id %>" title="Player">P
          </button>
          <button class="jd-circle jd-circle-b jd-circle--bw" id="btn-banker"
                  data-tipo="B" data-jugada-id="<%= @jugada_id %>" title="Banker">B
          </button>
        </div>

        <div class="jd-bw-row-btns">
          <button type="button" class="jd-undo-btn jd-undo-btn--bw" id="btn-undo"
                  data-jugada-id="<%= @jugada_id %>"
                  data-label-default="Undo Last Hand"
                  data-label-loading="Undoing..."
                  <%= 'disabled' if jd_finalizada %>>
            Undo Last Hand
          </button>
          <button type="button" class="jd-reset-btn" id="btn-reset"
                  data-jugada-id="<%= @jugada_id %>"
                  data-label-default="Clear Session"
                  data-label-loading="Clearing..."
                  <%= 'disabled' if jd_finalizada %>>
            Clear Session
          </button>
          <%= link_to 'Regresar', jugadas_path, class: 'jd-back-btn' %>
        </div>
      </div>

      <footer class="jd-bw-foot jd-bw-foot--sidebar">
        <span>Movimientos: <strong id="mov-count"><%= @total_movimientos %></strong></span>
        <span id="prc-badge"
              class="jd-badge jd-badge-green jd-badge--ft"
              style="display:<%= @total_movimientos > 5 ? 'inline-flex' : 'none' %>; margin-left:8px;">
          PRC activo
        </span>
        <span class="jd-powered">ImahSoftware</span>
      </footer>
    </aside>

    <div class="jd-bw-col-table">
      <section class="jd-bw-frequency">
        <h2 class="jd-bw-ft-title">
          Frequency Table
          <span class="jd-badge jd-badge--ft" id="badge-count"><%= @total_movimientos %></span>
        </h2>

        <div id="jd-floating-header" class="jd-floating-header jd-floating-header--bw" style="display:none;"></div>

        <div id="jd-movimientos-scroll" class="jd-movimientos-scroll--bw">
          <div id="tabla-movimientos">
            <%= render 'tabla_movimientos', jugadasdetalles: @jugadasdetalles %>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
    $(function(){
        // ═══ Floating header: clona el encabezado de JUGADA 1/2 y lo muestra al scrollear ═══
        function setupFloatingHeader(){
            var $scroll = $('#jd-movimientos-scroll');
            var $float  = $('#jd-floating-header');
            if (!$scroll.length || !$float.length) return;

            // Buscar los theads de JUGADA 1 y JUGADA 2 (columnas left y right)
            var $left  = $scroll.find('.bac-scorecard-left table thead');
            var $right = $scroll.find('.bac-scorecard-right table thead');
            var $centerTop = $scroll.find('.bac-table-central-top thead');

            // Si no hay theads (menos de 6 registros), no hacer nada
            if (!$left.length && !$right.length) {
                $float.hide();
                return;
            }

            // Construir el header clonado con la misma estructura grid
            var html = '<div style="display:grid; grid-template-columns:1fr auto 1fr; min-width:640px;">';

            // Left header
            html += '<div style="grid-column:1;">';
            html += '<table class="bac-table" style="margin:0;"><thead>' + $left.html() + '</thead></table>';
            html += '</div>';

            // Center header (P|B)
            html += '<div style="grid-column:2; min-width:90px; max-width:120px; border-left:2px solid #9ca3af; border-right:2px solid #9ca3af;">';
            html += '<table class="bac-table" style="margin:0; border-left:none; border-right:none;"><thead>' + $centerTop.html() + '</thead></table>';
            html += '</div>';

            // Right header
            html += '<div style="grid-column:3;">';
            html += '<table class="bac-table" style="margin:0;"><thead>' + $right.html() + '</thead></table>';
            html += '</div>';

            html += '</div>';
            $float.html(html);

            // Obtener la posición del header original de JUGADA 1
            var $origHeader = $scroll.find('.bac-scorecard-left table thead');

            $scroll.off('scroll.floatingHeader').on('scroll.floatingHeader', function(){
                if (!$origHeader.length) return;

                // Posición del header original relativo al contenedor scroll
                var headerTop = $origHeader[0].getBoundingClientRect().top;
                var scrollTop = $scroll[0].getBoundingClientRect().top;

                if (headerTop < scrollTop) {
                    // El header original ya no es visible → mostrar el flotante
                    $float.show();
                    // Sincronizar scroll horizontal
                    $float[0].scrollLeft = $scroll[0].scrollLeft;
                } else {
                    $float.hide();
                }
            });

            // Sincronizar scroll horizontal del body al header
            $scroll.off('scroll.floatingSync').on('scroll.floatingSync', function(){
                if ($float.is(':visible')) {
                    $float[0].scrollLeft = $scroll[0].scrollLeft;
                }
            });
        }

        setupFloatingHeader();

        // Exponer para que los JS de create/undo puedan reinicializar
        window.setupFloatingHeader = setupFloatingHeader;

        // Auto-scroll al último registro
        var $scroll = $('#jd-movimientos-scroll');
        if ($scroll.length && $scroll[0].scrollHeight > $scroll[0].clientHeight) {
            setTimeout(function(){ $scroll.scrollTop($scroll[0].scrollHeight); }, 100);
        }
    });
</script>
