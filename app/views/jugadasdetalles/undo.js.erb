// app/views/jugadasdetalles/undo.js.erb

// Actualizar contador de undos en el botón (para feedback visual en no-admins)
(function(){
  var $btn = $('#btn-undo');
  if ($btn.length) {
    var newCount = parseInt('<%= @undo_count.to_i %>', 10);
    var max      = $btn.data('undo-max');
    $btn.attr('data-undo-count', newCount);
    if (max !== '' && max !== undefined && newCount >= parseInt(max, 10)) {
      $btn.prop('disabled', true).addClass('disabled');
    }
  }
})();

$('#tabla-movimientos').html('<%= j render("tabla_movimientos", jugadasdetalles: @jugadasdetalles || []) %>');
$('#mov-count').text('<%= @total_movimientos %>');
$('#badge-count').text('<%= @total_movimientos %>');
$('#next-bet-text').text('<%= j @proximo_bet %>');
$('#jd-profit-amount').text('<%= j Jugadasdetalle.formatted_profit_for_jugada(@jugada_id) %>');
if (typeof window.applyProfitColor === 'function') { window.applyProfitColor(); }
<% if @total_movimientos.to_i > 0 %>
$('#btn-finish').show();
<% else %>
$('#btn-finish').hide();
<% end %>

<% if @total_movimientos < 5 %>
$('#prc-badge').hide();
<% end %>

// ═══ Reiniciar floating header + auto-scroll ═══
(function(){
    if (typeof window.syncMovimientosHeight === 'function') {
        window.syncMovimientosHeight();
    }
    if (typeof window.setupFloatingHeader === 'function') {
        window.setupFloatingHeader();
    }
    var el = document.getElementById('jd-movimientos-scroll');
    if (el) {
        setTimeout(function(){
            if (typeof window.syncMovimientosHeight === 'function') {
                window.syncMovimientosHeight();
            }
            if (typeof window.setupFloatingHeader === 'function') {
                window.setupFloatingHeader();
            }
            el.scrollTop = el.scrollHeight;
        }, 50);
    }
})();

<% if @jugada.present? && @jugada.estado.to_s.upcase.strip != 'PENDIENTE' %>
if (typeof window.jdLockPlayControls === 'function') { window.jdLockPlayControls(); }
<% end %>

