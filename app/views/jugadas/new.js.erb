<% if @active_record.present? %>
	$("#jugada_<%= @active_record.id %>").replaceWith("<%= j render 'tr', jugada: @active_record %>");
<% end %>
$("#jugada_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#jugada_form").collapse("show");
$(".select2").select2();
