<% title t(:jugadas) %>

<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><%= t(:jugadas) %></h3>
    <div class="box-tools pull-right">
      <% if is_persona && @persona_bloquea_nueva_jugada %>
        <span id="new_jugada_button" class="text-muted" style="cursor:not-allowed;opacity:0.45;" data-toggle="tooltip" title="<%= t('close_or_finish_pending_play') %>">
          <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
        </span>
      <% elsif is_persona && @persona_ultima_cerrada.present? %>
        <%# Para PERSONA con jugada cerrada anterior: también abrir el modal vía AJAX
            (antes hacía POST directo a nueva_shoe_jugada_path → fallaba sin monto_apostar).
            Pasamos from_jugada_id por si el create lo necesita. %>
        <%= link_to new_jugada_path(from_jugada_id: @persona_ultima_cerrada.to_param),
            remote: true,
            class: 'btn btn-sm btn-success btn-flat',
            id: 'new_jugada_button',
            data: { toggle: 'tooltip' },
            title: t('create_new_shoe_from_closed_play') do %>
          <i class="fa fa-plus" aria-hidden="true"></i> <%= t(:new_play) %>
        <% end %>
      <% elsif is_persona %>
        <%= link_to new_jugada_path, remote: true, id: 'new_jugada_button', class: 'btn btn-sm btn-success', data: { toggle: 'tooltip' }, title: t('new_play') do %>
          <i class="fa fa-plus fa-fw" aria-hidden="true"></i> <%= t(:new_play) %>
        <% end %>
      <% else %>
        <%= link_to new_jugada_path, remote: true, id: 'new_jugada_button', class: 'btn btn-sm btn-success', data: { toggle: 'tooltip' }, title: t('new_play') do %>
          <i class="fa fa-plus fa-fw" aria-hidden="true"></i> <%= t(:new_play) %>
        <% end %>
      <% end %>
    </div>
  </div><!-- /.box-header -->
  <div class="flash_messages"></div>
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <%# Modal para crear una nueva jugada (se llena vía AJAX desde new.js.erb) %>
        <div class="modal fade" id="jugada_form_modal" tabindex="-1" role="dialog" aria-labelledby="jugada_form_modal_label">
          <div class="modal-dialog" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="jugada_form_modal_label"><%= t(:new_play) %></h4>
              </div>
              <div class="modal-body" id="jugada_form"></div>
            </div>
          </div>
        </div>

        <div id="jugadas">
          <% if @portafolio_tabs.present? %>
            <div class="nav-tabs-custom">
              <ul class="nav nav-tabs" role="tablist">
                <% @portafolio_tabs.each_with_index do |tab, idx| %>
                  <li role="presentation" class="<%= 'active' if idx.zero? %>">
                    <a href="#jugadas-portafolio-<%= tab[:id] %>"
                       class="jugadas-portafolio-tab"
                       data-toggle="tab"
                       data-portafolio-id="<%= tab[:id] %>"
                       role="tab"
                       aria-expanded="<%= idx.zero? ? 'true' : 'false' %>">
                      <i class="fa fa-gamepad"></i>
                      <%= tab[:name] %> <span class="label label-default"><%= tab[:count] %></span>
                    </a>
                  </li>
                <% end %>
                <li role="presentation">
                  <a href="#jugadas-buscar"
                     class="jugadas-search-tab"
                     data-toggle="tab"
                     role="tab"
                     aria-expanded="false">
                    <i class="fa fa-search"></i> <%= t(:buscar) %>
                  </a>
                </li>
              </ul>
              <div class="tab-content">
                <% @portafolio_tabs.each_with_index do |tab, idx| %>
                  <div role="tabpanel"
                       class="tab-pane <%= 'active' if idx.zero? %>"
                       id="jugadas-portafolio-<%= tab[:id] %>"
                       data-jugadas-loaded="false">
                    <div class="text-muted">
                      <i class="fa fa-info-circle"></i>
                      Click en pestaña para cargar jugadas.
                    </div>
                  </div>
                <% end %>
                <div role="tabpanel"
                     class="tab-pane"
                     id="jugadas-buscar"
                     data-jugadas-search-loaded="false">
                  <div class="box box-default" style="margin-top:10px;">
                    <div class="box-body">
                      <form id="jugadas-search-form" class="form-inline">
                        <div class="form-group" style="width:100%;max-width:680px;">
                          <label class="sr-only" for="jugadas-search-input">Search</label>
                          <input id="jugadas-search-input"
                                 type="text"
                                 class="form-control"
                                 style="width:80%;"
                                 placeholder="Play ID, name, username, or ID number">
                          <button type="submit" class="btn btn-primary">
                            <i class="fa fa-search"></i> <%= t(:search_button) %>
                          </button>
                        </div>
                      </form>
                      <hr style="margin:12px 0;">
                      <div id="jugadas-search-results" class="text-muted">
                        Enter a play ID or user criteria to search.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  if (window.__jugadasPortafolioTabsBound) return;
  window.__jugadasPortafolioTabsBound = true;

  function loadTab($tabLink){
    var portafolioId = $tabLink.data('portafolio-id');
    var target = $tabLink.attr('href');
    if(!portafolioId || !target) return;

    var $pane = $(target);
    if(!$pane.length) return;
    if($pane.data('jugadas-loaded') === true) return;

    $pane.html('<p class="text-muted"><i class="fa fa-refresh fa-spin"></i> Cargando jugadas...</p>');

    $.get('<%= tabla_portafolio_jugadas_path %>', { portafolio_id: portafolioId })
      .done(function(html){
        $pane.html(html);
        $pane.data('jugadas-loaded', true);
      })
      .fail(function(){
        $pane.html('<div class="alert alert-danger">No se pudo cargar jugadas de este portafolio.</div>');
      });
  }

  $(document).on('shown.bs.tab', '.jugadas-portafolio-tab', function(e){
    loadTab($(e.target));
  });

  function loadSearchResults(params){
    var $results = $('#jugadas-search-results');
    if(!$results.length) return;
    $results.html('<p class="text-muted"><i class="fa fa-refresh fa-spin"></i> Buscando...</p>');

    $.get('<%= tabla_buscar_jugadas_path %>', params || {})
      .done(function(html){
        $results.html(html);
      })
      .fail(function(){
        $results.html('<div class="alert alert-danger">No se pudo realizar la búsqueda.</div>');
      });
  }

  $(document).on('submit', '#jugadas-search-form', function(ev){
    ev.preventDefault();
    var q = $.trim($('#jugadas-search-input').val());
    if(!q){
      $('#jugadas-search-results').html('<div class="alert alert-warning">Ingresa un criterio de búsqueda.</div>');
      return;
    }
    loadSearchResults({ q: q });
  });

  $(document).on('click', '.jugadas-user-pick', function(ev){
    ev.preventDefault();
    var userId = $(this).data('user-id');
    if(!userId) return;
    loadSearchResults({ user_id: userId });
  });

  $(function(){
    var $first = $('.jugadas-portafolio-tab').first();
    if($first.length) loadTab($first);
  });
})();
</script>
