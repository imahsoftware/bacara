<style>
  body {
    background: #fff;
    font-family: Arial, sans-serif;
    color: #0a0a0a;
  }
  .pdf-document-root {
    position: relative;
  }
  /* Logo en flujo: misma fila que .pdf-mini → vertical-align middle alinea sin absolute */
  .pdf-logo-wrap {
    position: relative;
    left: 80px;
    display: inline-block;
    max-width: 180px;
    width: 100%;
    line-height: 0;
    vertical-align: middle;
  }
  .pdf-logo-wrap img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  .pdf-mini {
    width: auto;
    border-collapse: collapse;
    margin: 0;
    font-size: 10px;
  }
  .pdf-mini th, .pdf-mini td {
    border: 1px solid #d1d5db;
    padding: 4px 6px;
    text-align: center;
  }
  /* Mismo tono que fecha agrupada en index jugadas (.jugadas-day-header) */
  .pdf-mini thead th {
    background: #4a5f7a;
    color: #fff;
    font-weight: 700;
    font-size: 10px;
    border-color: #5a7088;
  }
  .pdf-mini tbody td {
    background: #f9fafb;
  }
  .pdf-mini .text-right {
    text-align: right;
    padding-right: 10px;
  }
  .pdf-mini .jd-profit-pos { color: #15803d; font-weight: 700; }
  .pdf-mini .jd-profit-neg { color: #b91c1c; font-weight: 700; }
  .pdf-mini .jd-profit-zero { color: #6b7280; font-weight: 700; }
  .pdf-mini .play-num {
    font-weight: 700;
  }
  .pdf-head {
    width: 100%;
    display: table;
    table-layout: fixed;
    margin: 0 0 4px;
  }
  .pdf-head-left,
  .pdf-head-right {
    display: table-cell;
    vertical-align: middle;
  }
  .pdf-head-left {
    width: 30%;
    padding-right: 10px;
    text-align: left;
  }
  .pdf-head-right {
    width: 70%;
    text-align: right;
  }
  /* Tabla resumen al borde derecho del bloque header */
  .pdf-head-right .pdf-mini {
    width: auto;
    max-width: 100%;
    margin: 0;
    display: inline-table;
  }
  .pdf-score-stack {
    margin-top: 0;
    padding-top: 0;
  }
  /* Sin doble línea entre última fila fase A y fila transición (cabeceras + PB mano 5) */
  .pdf-score-stack .pdf-phase-a + .pdf-phase-b tbody:first-of-type tr.pdf-row-transition > th,
  .pdf-score-stack .pdf-phase-a + .pdf-phase-b tbody:first-of-type tr.pdf-row-transition > td {
    border-top: none !important;
  }
  /* Cabeceras laterales en fila transición (misma altura que fila datos) */
  .pdf-phase-b tr.pdf-row-transition > th {
    height: var(--pdf-row-h);
    line-height: var(--pdf-row-h);
    background: #191d26 !important;
    color: #fff;
    border-color: #2c3138;
    font-size: 10px;
    font-weight: 700;
  }
  .pdf-phase-b tr.pdf-row-transition > th.col-p-head { color: #7fb2ff !important; }
  .pdf-phase-b tr.pdf-row-transition > th.col-b-head { color: #ff8d8d !important; }
  /* No pintar encabezados con verde/rojo/amarillo finalizar */
  .pdf-phase-b tr.pdf-row-transition.tr-finalizar-ok > th,
  .pdf-phase-b tr.pdf-row-transition.tr-finalizar > th,
  .pdf-phase-b tr.pdf-row-transition.tr-finalizar-z > th {
    background: #191d26 !important;
    color: #fff !important;
  }
  .pdf-table-wrap .jd-empty { display: none; }

  /* ===== Una sola tabla = mismo salto de página en izq / centro / der (wkhtmltopdf) ===== */
  :root {
    --pdf-head-h: 24px;
    --pdf-row-h: 28px;
  }
  .pdf-table-wrap {
    width: 100%;
    overflow: visible;
    font-size: 11px;
    margin-top: 2px;
    background: #fff;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
  }
  .pdf-unified {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 11px;
    background: #fff;
  }
  .pdf-unified thead {
    display: table-header-group;
  }
  .pdf-unified th,
  .pdf-unified td {
    border: 1px solid #d8dde4;
    padding: 0 6px;
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
    height: var(--pdf-row-h);
    line-height: var(--pdf-row-h);
    color: #0a0a0a;
    font-weight: 400;
  }
  .pdf-unified thead th {
    height: var(--pdf-head-h);
    line-height: var(--pdf-head-h);
    background: #191d26;
    color: #fff;
    border-color: #2c3138;
    font-size: 10px;
    font-weight: 700;
  }
  .pdf-unified thead th.col-p-head { color: #7fb2ff !important; }
  .pdf-unified thead th.col-b-head { color: #ff8d8d !important; }
  /* Primeras 5 filas: laterales sin encabezado ni contenido visible */
  .pdf-unified thead th.pdf-th-side-blank {
    background: #fff !important;
    border-color: #fff !important;
    color: transparent !important;
    padding: 0 !important;
  }
  .pdf-unified tbody td.pdf-empty-zone {
    background: #fff !important;
    border-color: #fff !important;
    padding: 0 !important;
    height: var(--pdf-row-h);
  }
  .pdf-phase-a { margin: 0; border-spacing: 0; }
  .pdf-phase-b { margin: 0; border-spacing: 0; }
  /* Un tbody por mano: evita partir solo la columna central al saltar página */
  .pdf-unified tbody.pdf-hand-block {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
  .pdf-unified tbody.pdf-hand-block tr {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
  .pdf-unified tbody.pdf-hand-block tr.pdf-row-a td { background: #f3f4f6; }
  .pdf-unified tbody.pdf-hand-block tr.pdf-row-b td { background: #dfe7e3; }
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar-ok td { background: #9dd9ad !important; }
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar td { background: #f5bcbc !important; }
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar-z td { background: #fbf0a8 !important; }
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar-ok td.pdf-empty-zone,
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar td.pdf-empty-zone,
  .pdf-unified tbody.pdf-hand-block tr.tr-finalizar-z td.pdf-empty-zone {
    background: #fff !important;
  }

  .pdf-unified .td-num { background: #eceff1 !important; width: 28px; }
  .pdf-unified .td-central-p {
    background: #e8f1ff !important;
    border-left: 3px solid #9ca3af;
  }
  .pdf-unified .td-central-b {
    background: #fde8e9 !important;
    border-right: 3px solid #9ca3af;
  }
  .pdf-unified thead th.pdf-th-central-pb {
    border-left: 3px solid #9ca3af !important;
    border-right: 3px solid #9ca3af !important;
  }
  .pdf-unified .bac-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
  }
  .pdf-unified .bac-chip-p { background: #2563eb; }
  .pdf-unified .bac-chip-b { background: #dc2626; }
  .pdf-unified .bac-chip-none {
    background: transparent;
    color: #4b5563;
    font-weight: 400;
    font-size: 12px;
  }

  .pdf-unified thead tr:first-child th:first-child { border-top-left-radius: 8px; }
  .pdf-unified thead tr:first-child th:last-child  { border-top-right-radius: 8px; }
</style>

<div class="pdf-document-root">
<div class="pdf-head">
  <div class="pdf-head-left">
    <div class="pdf-logo-wrap" aria-hidden="true">
      <img src="https://bacwins.bot/assets/bacwins-a620e961d39557f10389f72bb8938d43bca7b190d1f92bb45516e8fb0772a9d5.png" alt="BacWins">
    </div>
  </div>
  <div class="pdf-head-right">
  </div>
</div>

<%
  pdf_profit_val = @jugadasdetalles.sum { |d| d.acumuladof.to_f }
  pdf_profit_str = if pdf_profit_val == pdf_profit_val.to_i
                     pdf_profit_val.to_i.to_s
                   else
                     sprintf('%.1f', pdf_profit_val)
                   end
  pdf_profit_txt = pdf_profit_val > 0 ? "+#{pdf_profit_str}" : pdf_profit_str
  pdf_profit_cls = pdf_profit_val > 0 ? 'jd-profit-pos' : (pdf_profit_val < 0 ? 'jd-profit-neg' : 'jd-profit-zero')
%>

<div style="margin-top: 12px; display: table; width: 100%;">
  <table class="pdf-mini" style="display: table; width: auto; margin-left: 60px;">
    <thead>
      <tr>
        <th><%= t(:shoes) %></th>
        <th><%= t(:date_time) %></th>
        <th><%= t(:status) %></th>
        <th><%= t(:profit) %></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="play-num">#<%= @jugada.id %></td>
        <td><%= @jugada.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td>
          <% estado_text = case @jugada.estado.to_s.upcase
            when 'PENDIENTE' then t(:pending)
            when 'CERRADA' then t(:closed)
            when 'FINALIZADA' then t(:finalized)
            else @jugada.estado
          end %>
          <%= estado_text %>
        </td>
        <td class="text-right <%= pdf_profit_cls %>"><%= pdf_profit_txt %></td>
      </tr>
    </tbody>
  </table>
</div>

<%
  pdf_rows = @jugadasdetalles.select do |d|
    d.r_player.present? || d.r_banker.present? ||
    d.player1.present? || d.banquer1.present? || d.resultado1.present? || d.final.present? || d.acumulado.present? ||
    d.player2.present? || d.banquer2.present? || d.resultado2.present? || d.final2.present? || d.acumulado2.present? ||
    d.acumuladof.present?
  end
  pdf_left_cols  = @pdf_show_mecanicas ? 7 : 6
  pdf_right_cols = @pdf_show_mecanicas ? 7 : 6
  # 4 filas solo centro; la 5ª mano va en la misma fila que cabeceras izq/der
  pdf_phase_a = pdf_rows.first(4)
  pdf_hand5   = pdf_rows[4] if pdf_rows.size >= 5
  pdf_phase_b = pdf_rows.drop(5)
  pdf_fin_row_class = lambda do |d|
    fv = d.respond_to?(:finalizar) ? d.finalizar.to_s.strip.upcase : ''
    case fv
    when 'Y' then 'tr-finalizar-ok'
    when 'Z' then 'tr-finalizar-z'
    else (fv.present? ? 'tr-finalizar' : '')
    end
  end
  # Anchos iguales fase A / B → columna P|B alineada en todo el bloque (mockup imagen 2)
  pdf_mid_col_w  = 7.0
  pdf_side_col_w = (43.0 / pdf_left_cols).round(4)
%>

<div class="pdf-table-wrap jd-bw-page">
  <div class="pdf-score-stack">
  <% if pdf_phase_a.any? %>
    <table class="pdf-unified pdf-phase-a">
      <colgroup>
        <% pdf_left_cols.times do %>
          <col style="width: <%= pdf_side_col_w %>%;">
        <% end %>
        <col style="width: <%= pdf_mid_col_w %>%;">
        <col style="width: <%= pdf_mid_col_w %>%;">
        <% pdf_right_cols.times do %>
          <col style="width: <%= pdf_side_col_w %>%;">
        <% end %>
      </colgroup>
      <thead>
        <tr>
          <th colspan="<%= pdf_left_cols %>" class="pdf-th-side-blank">&nbsp;</th>
          <th colspan="2" class="pdf-th-central-pb">P &nbsp;|&nbsp; B</th>
          <th colspan="<%= pdf_right_cols %>" class="pdf-th-side-blank">&nbsp;</th>
        </tr>
      </thead>
      <% pdf_phase_a.each_with_index do |d, idx| %>
        <tbody class="pdf-hand-block">
          <tr class="<%= pdf_fin_row_class.call(d) %> <%= idx.even? ? 'pdf-row-a' : 'pdf-row-b' %>">
            <td colspan="<%= pdf_left_cols %>" class="pdf-empty-zone"><%# lateral vacío %></td>
            <td class="td-central-p">
              <% if d.r_player == 1 %>
                <span class="bac-chip bac-chip-p">P</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <td class="td-central-b">
              <% if d.r_banker == 1 %>
                <span class="bac-chip bac-chip-b">B</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <td colspan="<%= pdf_right_cols %>" class="pdf-empty-zone"><%# lateral vacío %></td>
          </tr>
        </tbody>
      <% end %>
    </table>
  <% end %>

  <% if pdf_hand5.present? || pdf_phase_b.any? %>
    <table class="pdf-unified pdf-phase-b">
      <colgroup>
        <% pdf_left_cols.times do %>
          <col style="width: <%= pdf_side_col_w %>%;">
        <% end %>
        <col style="width: <%= pdf_mid_col_w %>%;">
        <col style="width: <%= pdf_mid_col_w %>%;">
        <% pdf_right_cols.times do %>
          <col style="width: <%= pdf_side_col_w %>%;">
        <% end %>
      </colgroup>
      <% if pdf_hand5.present? %>
        <tbody class="pdf-hand-block">
          <tr class="pdf-row-transition <%= pdf_fin_row_class.call(pdf_hand5) %> <%= 4.even? ? 'pdf-row-a' : 'pdf-row-b' %>">
            <th>#</th>
            <% if @pdf_show_mecanicas %><th>MEC</th><% end %>
            <th class="col-p-head">P</th>
            <th class="col-b-head">B</th>
            <th>✓ / ✗</th>
            <th>RESULT</th>
            <th>ACCUM</th>
            <td class="td-central-p">
              <% if pdf_hand5.r_player == 1 %>
                <span class="bac-chip bac-chip-p">P</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <td class="td-central-b">
              <% if pdf_hand5.r_banker == 1 %>
                <span class="bac-chip bac-chip-b">B</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <% if @pdf_show_mecanicas %><th>MEC</th><% end %>
            <th class="col-p-head">P</th>
            <th class="col-b-head">B</th>
            <th>✓ / ✗</th>
            <th>RESULT</th>
            <th>ACCUM</th>
            <th>FINAL</th>
          </tr>
        </tbody>
      <% end %>
      <% pdf_phase_b.each_with_index do |d, i| %>
        <% idx = i + 5 %>
        <tbody class="pdf-hand-block">
          <tr class="<%= pdf_fin_row_class.call(d) %> <%= idx.even? ? 'pdf-row-a' : 'pdf-row-b' %>">
            <td class="td-num"><%= i + 1 %></td>
            <% if @pdf_show_mecanicas %><td><%= d.mecanica1.presence || '—' %></td><% end %>
            <td><%= d.player1.present? ? d.player1 : '—' %></td>
            <td><%= d.banquer1.present? ? d.banquer1 : '—' %></td>
            <td>
              <% if d.resultado1 == 1 %>✓
              <% elsif d.resultado1 == 0 %>✗
              <% else %>—<% end %>
            </td>
            <td><%= d.final.present? ? (d.final > 0 ? "+#{d.final}" : d.final) : '—' %></td>
            <td><%= d.acumulado.present? ? (d.acumulado > 0 ? "+#{d.acumulado}" : d.acumulado) : '—' %></td>
            <td class="td-central-p">
              <% if d.r_player == 1 %>
                <span class="bac-chip bac-chip-p">P</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <td class="td-central-b">
              <% if d.r_banker == 1 %>
                <span class="bac-chip bac-chip-b">B</span>
              <% else %>
                <span class="bac-chip bac-chip-none">–</span>
              <% end %>
            </td>
            <% if @pdf_show_mecanicas %><td><%= d.mecanica2.presence || '—' %></td><% end %>
            <td><%= d.player2.present? ? d.player2 : '—' %></td>
            <td><%= d.banquer2.present? ? d.banquer2 : '—' %></td>
            <td>
              <% if d.resultado2 == 1 %>✓
              <% elsif d.resultado2 == 0 %>✗
              <% else %>—<% end %>
            </td>
            <td><%= d.final2.present? ? (d.final2 > 0 ? "+#{d.final2}" : d.final2) : '—' %></td>
            <td><%= d.acumulado2.present? ? (d.acumulado2 > 0 ? "+#{d.acumulado2}" : d.acumulado2) : '—' %></td>
            <td><%= d.acumuladof.present? ? (d.acumuladof > 0 ? "+#{d.acumuladof}" : d.acumuladof) : '—' %></td>
          </tr>
        </tbody>
      <% end %>
    </table>
  <% end %>
  </div>
</div>
</div>