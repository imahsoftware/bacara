<table class="table table-bordered table-condensed table-striped">
  <thead>
  <tr class="thcolor">
    <th class="text-center" width="15%">Acciones</th>
    <th>Jugador</th>
  </tr>
  </thead>
  <tbody id="tbody_jugadas">
  <% @jugadas.order(created_at: :desc).each do |jugada| %>
    <%= render 'jugadas/tr', jugada: jugada %>
  <% end %>
  </tbody>
</table>

<div class="box-footer clear-fix">
  <div class="box-tools pull-right">
    <%= will_paginate @jugadas, renderer: BootstrapPagination::Rails %>
  </div>
</div>
