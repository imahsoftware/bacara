<%
  jugadas_by_day = @jugadas.order(created_at: :desc).group_by { |j| j.created_at.to_date }
  today = Date.current
  show_player_col = current_user.tipoconsulta.to_s != 'PERSONA'
  total_cols      = show_player_col ? 8 : 7
  total_colspan   = show_player_col ? 7 : 6
  jugada_ids = @jugadas.map(&:id)
  # :final, no :acumuladof — mismo campo que usa el PROFIT en la pantalla de juego
  # (Jugadasdetalle.sum_acumuladof_for_jugada), para que el total del listado coincida.
  profit_by_jugada = Jugadasdetalle.where(jugada_id: jugada_ids).group(:jugada_id).sum(:final)
  docs_by_jugada   = Jugadasdoc.where(jugada_id: jugada_ids).order(:id).group_by(&:jugada_id)
%>

<table class="table table-bordered table-condensed table-striped jugadas-table">
  <%# Sin thead global: la fila Actions / Shoe / … va antes de cada bloque de datos del día %>
  <tbody id="tbody_jugadas">
  <% jugadas_by_day.each do |day, jugadas_del_dia| %>
    <%
      es_hoy       = (day == today)
      day_id       = day.strftime("%Y%m%d")
      day_total    = jugadas_del_dia.sum { |j| profit_by_jugada[j.id].to_f }
      total_class  = day_total > 0 ? 'jd-profit-pos' : (day_total < 0 ? 'jd-profit-neg' : 'jd-profit-zero')
      # Si todas las jugadas del día usan la misma denominación, mostrar su símbolo en el total.
      # Si hay varias monedas mezcladas ese día, no se antepone símbolo (sumar monedas distintas no tiene sentido).
      day_denominaciones   = jugadas_del_dia.map { |j| j.denominacion&.simbolo }.compact.uniq
      day_currency_symbol  = day_denominaciones.size == 1 ? day_denominaciones.first : nil
      day_total_text = format_jugada_profit_value(day_total)
      day_total_text = "#{day_currency_symbol} #{day_total_text}" if day_currency_symbol.present?
    %>

    <% if es_hoy %>
      <%# ─── HOY: consolidado del día + filas + footer Daily Total ── %>
      <% if show_player_col %>
        <%= render 'jugadas/consolidado_por_dia',
                   rows: jugadas_consolidado_rows_for_dia(jugadas_del_dia, profit_by_jugada),
                   total_cols: total_cols,
                   show_player_col: show_player_col,
                   day_class: nil,
                   initially_hidden: false %>
      <% end %>
      <%= render 'jugadas/datagrid_head_row',
                 show_player_col: show_player_col,
                 day_class: nil,
                 initially_hidden: false %>
      <% jugadas_del_dia.each do |jugada| %>
        <%= render 'jugadas/tr', jugada: jugada, show_player_col: show_player_col, docs: docs_by_jugada[jugada.id] || [] %>
      <% end %>
      <tr class="jugadas-day-total <%= total_class %>">
        <td colspan="<%= total_colspan %>" class="text-right">
          <strong><%= t(:daily_total) %>:</strong>
        </td>
        <td class="text-right">
          <strong><%= day_total_text %></strong>
        </td>
      </tr>

    <% else %>
      <%# ─── DÍA PASADO: header colapsable (click para desplegar) ─── %>
      <tr class="jugadas-day-header jugadas-day-header--collapsible <%= total_class %>"
          data-toggle-day="day-<%= day_id %>"
          aria-expanded="false"
          role="button"
          tabindex="0">
        <td colspan="<%= total_cols %>">
          <div class="jugadas-day-header__layout">
            <div class="jugadas-day-header__left">
              <i class="fa fa-chevron-right jugadas-day-toggle-icon"></i>
              <i class="fa fa-calendar-o"></i>
              <strong><%= day.strftime("%Y-%m-%d") %></strong>
              <span class="jugadas-day-header__count">
                (<%= jugadas_del_dia.size %> <%= t(:plays_lower) %>)
              </span>
            </div>
            <div class="jugadas-day-header__right">
              <%= day_total_text %>
            </div>
          </div>
        </td>
      </tr>

      <% if show_player_col %>
        <%= render 'jugadas/consolidado_por_dia',
                   rows: jugadas_consolidado_rows_for_dia(jugadas_del_dia, profit_by_jugada),
                   total_cols: total_cols,
                   show_player_col: show_player_col,
                   day_class: "day-#{day_id}",
                   initially_hidden: true %>
      <% end %>
      <%= render 'jugadas/datagrid_head_row',
                 show_player_col: show_player_col,
                 day_class: "day-#{day_id}",
                 initially_hidden: true %>
      <%# Las filas de este día empiezan ocultas; el JS las muestra al click %>
      <% jugadas_del_dia.each do |jugada| %>
        <%= render 'jugadas/tr',
                   jugada: jugada,
                   show_player_col: show_player_col,
                   docs: docs_by_jugada[jugada.id] || [],
                   day_class: "day-#{day_id}",
                   initially_hidden: true %>
      <% end %>
    <% end %>
  <% end %>
  </tbody>
</table>
