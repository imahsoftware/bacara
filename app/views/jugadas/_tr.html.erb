<%
  cerrada = jugada.estado.to_s.strip.upcase == 'CERRADA'
  profit  = Jugadasdetalle.where(jugada_id: jugada.id).sum(:acumuladof).to_f
  profit_class = profit > 0 ? 'jd-profit-pos' : (profit < 0 ? 'jd-profit-neg' : 'jd-profit-zero')
  iv_str   = profit == profit.to_i ? profit.to_i.to_s : sprintf('%.1f', profit)
  profit_text = profit > 0 ? "+#{iv_str}" : iv_str

  # Locales opcionales para el agrupado por día
  row_day_class        = local_assigns[:day_class].to_s
  row_initially_hidden = local_assigns[:initially_hidden] == true
  show_player_col      = local_assigns[:show_player_col] == true
  docs                 = local_assigns[:docs] || []
  docs_count           = docs.size
%>
<tr id="jugada_<%= jugada.id %>"
    class="jugada-row <%= row_day_class %>"
    <%= row_initially_hidden ? 'style="display:none;"'.html_safe : '' %>>
  <td class="text-center">
    <% if current_user.tipoconsulta.to_s == 'TODO' && !cerrada %>
      <%= link_to jugada, remote: true, method: :delete, data: { confirm: "#{t :elimina_confirma}", toggle: 'tooltip' }, title: "#{t :title_elimina}" do %>
        <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
    <%# Solo admins (no-PERSONA) pueden generar el PDF %>
    <% if cerrada && current_user.tipoconsulta.to_s != 'PERSONA' %>
      <%= link_to detalle_jugadas_jugadas_path(id: jugada.to_param, format: :pdf), class: 'popup', data: { toggle: 'tooltip' }, title: 'Ver Detalle' do %>
        <button class="btn btn-xs btn-primary"><i class="fa fa-file-pdf-o"></i></button>
      <% end %>
    <% end %>

    <%# Botón para abrir el detalle de jugada en nueva ventana %>
    <%= link_to new_jugadasdetalle_path(jugada_id: jugada.to_param),
                rel: "noopener",
                data: { toggle: 'tooltip' },
                title: "#{t :ver_detalle_jugada}" do %>
      <button class="btn btn-xs btn-primary">
        <i class="fa fa-play-circle"></i>
      </button>
    <% end %>
  </td>
  <td class="text-center"><strong>#<%= jugada.id %></strong></td>
  <td class="text-center"><%= jugada.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
  <% if show_player_col %>
    <td class="text-left jugadas-player-cell">
      <% u = jugada.user %>
      <% if u %>
        <% if u.nombre.present? %>
          <strong><%= u.nombre %></strong><% if u.username.present? %> <small class="text-muted" style="font-size:11px;">(<%= u.username %>)</small><% end %>
        <% else %>
          <strong><%= u.username %></strong>
        <% end %>
      <% else %>
        <span class="text-muted">—</span>
      <% end %>
    </td>
  <% end %>
  <td class="text-center">
    <% estado_text = case jugada.estado.to_s.upcase
      when 'PENDIENTE' then t(:pending)
      when 'CERRADA' then t(:closed)
      when 'FINALIZADA' then t(:finalized)
      else jugada.estado
    end %>
    <%= estado_text %>
  </td>
  <%
    diff = (jugada.updated_at - jugada.created_at).to_i
    dur_text = if diff <= 0
      '—'
    elsif diff < 60
      "#{diff}s"
    elsif diff < 3600
      "%dm %02ds" % [diff / 60, diff % 60]
    else
      h = diff / 3600
      m = (diff % 3600) / 60
      "%dh %02dm" % [h, m]
    end
  %>
  <td class="text-center" style="font-size:12px; color:#666; white-space:nowrap;"><%= dur_text %></td>
  <td class="text-center" style="white-space:nowrap;">
    <% if docs.any? %>
      <div class="dropdown jugada-docs-dropdown" style="display:inline-block;">
        <a href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
           style="color:#337ab7; text-decoration:none; font-size:12px;"
           title="<%= docs_count %> documento<%= docs_count == 1 ? '' : 's' %>">
          <i class="fa fa-paperclip"></i> <small><strong><%= docs_count %></strong></small>
        </a>
        <ul class="dropdown-menu dropdown-menu-right jugada-docs-menu" style="min-width:220px; font-size:12px;">
          <li class="dropdown-header" style="font-size:11px;">
            <i class="fa fa-paperclip"></i> Documentos (<%= docs_count %>)
          </li>
          <% docs.each do |doc| %>
            <li>
              <%= link_to doc.documento.url, target: '_blank', rel: 'noopener',
                    style: 'display:flex; align-items:center; gap:6px; padding:6px 14px;' do %>
                <i class="fa fa-<%= doc.documento_content_type.to_s.include?('pdf') ? 'file-pdf-o text-danger' : 'file-image-o text-info' %>"
                   style="flex-shrink:0;"></i>
                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:160px;"
                      title="<%= h doc.descripcion.presence || doc.documento_file_name %>">
                  <%= doc.descripcion.presence || doc.documento_file_name %>
                </span>
                <i class="fa fa-download text-muted" style="margin-left:auto; flex-shrink:0;"></i>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <span class="text-muted">—</span>
    <% end %>
  </td>
  <td class="text-right <%= profit_class %>"><strong><%= profit_text %></strong></td>
</tr>
