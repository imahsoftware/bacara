<%= simple_form_for @jugada, remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-md-4">
        <%= f.input :jugador, input_html: { class: 'clean', :onchange => "javascript:this.value=this.value.toUpperCase();" } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @jugada.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: { target: '#jugada_form' }, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", jugada_path(@jugada), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
