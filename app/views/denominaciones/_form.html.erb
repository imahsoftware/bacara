<%= simple_form_for @denominacion do |f| %>
  <div class="box-body">
    <%= f.error_notification %>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :nombre, label: t(:denomination_name), input_html: { class: 'form-control' } %>
      </div>
      <div class="col-md-3">
        <%= f.input :codigo, label: t(:denomination_code), input_html: { class: 'form-control', maxlength: 10 } %>
      </div>
      <div class="col-md-3">
        <%= f.input :simbolo, label: t(:denomination_symbol), input_html: { class: 'form-control', maxlength: 10 } %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4">
        <%= f.input :estado,
                    label: t(:denomination_status),
                    collection: ['ACTIVO', 'INACTIVO'],
                    include_blank: false,
                    input_html: { class: 'form-control' } %>
      </div>
    </div>
  </div>
  <div class="box-footer">
    <%= link_to t(:cancelar), denominaciones_path, class: 'btn btn-default' %>
    <%= f.button :submit, t(:guardar), class: 'btn btn-danger pull-right' %>
  </div>
<% end %>
