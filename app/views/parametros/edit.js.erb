$("#parametro_form").collapse("hide");
$("#parametro_form").empty();

<% if @active_record.present? %>
  $("#parametro_<%= @active_record.id %>").replaceWith("<%= j render 'tr', parametro: @active_record %>");
<% end %>

$("#parametro_<%= @parametro.id %>").html("<td colspan='5'><%= j render 'form' %></td>");
$("#parametro_<%= @parametro.id %>").addClass("active_parametro");

$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
