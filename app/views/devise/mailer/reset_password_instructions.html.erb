<%
  @token = object0 if object0.present? rescue nil
  @username = object1 if object1.present? rescue nil
  @resource = User.find_by_username(@username) rescue nil
%>

<p><%= t :hola %> <%= @username rescue nil %>!</p>

<p><%= t :alguien_solicito_cambiar_contrasena %></p>

<p><%= link_to t(:cambiar_mi_contrasena), url_for(controller: 'users/passwords', action: 'edit', reset_password_token: @token, host: 'https://appasearesp.com') %></p>

<p><%= t :si_no_solicito_ignore %></p>
<p><%= t :contrasena_no_cambiara %></p>
