<div id="wrapper">

  <%= render 'devise/shared/auth_showcase' %>

  <!-- ── PANEL DERECHO: Formulario ── -->
  <div id="left">
    <div id="signin">

      <div class="logo">
        <h1><%= t :registro_usuario %></h1>
        <p class="form-subtitle"><%= t :ingresa_credenciales %></p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'idformreg', autocomplete: 'off' }) do |f| %>

        <%= f.hidden_field :gestion_id, value: 10002 %>

        <div>
          <label><%= t :correo_electronico %></label>
          <%= f.input_field :email, autocomplete: 'off', required: false, autofocus: true, class: 'form-control', placeholder: "#{t :correo_electronico}" %>
        </div>

        <div>
          <label><%= t :identificacion %></label>
          <%= f.input_field :identificacion, required: false, class: 'form-control', placeholder: "#{t :identificacion}" %>
        </div>

        <div>
          <label><%= t :fecha_nacimiento %></label>
          <%= f.input_field :fecha_nacimiento, as: :string, required: false, class: 'form-control datepicker', placeholder: "#{t :fecha_nacimiento}", data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true %>
        </div>

        <div>
          <label><%= t :contrasena %></label>
          <%= f.input_field :password, required: false, class: 'form-control', placeholder: "#{t :contrasena}", autocomplete: 'off', id: 'password_field' %>
        </div>

        <div>
          <label><%= t :confirmar_contrasena %></label>
          <%= f.input_field :password_confirmation, required: false, class: 'form-control', placeholder: "#{t :confirmar_contrasena}", autocomplete: 'off' %>
        </div>

        <br/>
        <div>
          <%= f.button :submit, "#{t :crear_cuenta}", class: 'primary-btn', disabled_with: "#{t :procesando}" %>
        </div>

      <% end %>

      <div class="links">
        <%= render "devise/shared/links" %>
      </div>

      <%= render 'layouts/flash_messages' %>
    </div>

    <footer id="main-footer">
      Copyright &copy; <%= Time.now.strftime("%Y") %> <b>ImahSoftware</b> · <span class="footer-app">BacWins</span> · <%= t :todos_derechos_reservados %>
    </footer>
  </div>

</div>

<%= render 'devise/shared/auth_styles' %>

<style>
    /* Ajuste para el form largo: que el card scrollee por dentro y no desborde */
    #left { overflow-y: auto; }
</style>
