<div id="wrapper">

  <%= render 'devise/shared/auth_showcase' %>

  <!-- ── PANEL DERECHO: Formulario ── -->
  <div id="left">
    <div id="signin">

      <div class="logo">
        <h1><%= t :reenvio_correo_confirmacion %></h1>
        <p class="form-subtitle"><%= t :ingresa_credenciales %></p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, id: 'idformconf', autocomplete: 'off' }) do |f| %>

        <%= f.full_error :confirmation_token %>

        <div>
          <label><%= t :correo_electronico %></label>
          <%= f.input_field :email, required: false, autofocus: true, value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email), class: 'form-control', placeholder: "#{t :correo_electronico}", autocomplete: 'off' %>
        </div>

        <br/>
        <div>
          <%= f.button :submit, "#{t :reenviar_correo}", class: 'primary-btn', disabled_with: "#{t :enviando}" %>
        </div>

      <% end %>

      <div class="links">
        <%= render "devise/shared/links" %>
      </div>

      <%= render 'layouts/flash_messages' %>
    </div>

    <footer id="main-footer">
      Copyright &copy; <%= Time.now.strftime("%Y") %> <b>ImahSoftware</b> · <span class="footer-app">BacWins</span> · <%= t :todos_derechos_reservados %>
    </footer>
  </div>

</div>

<%= render 'devise/shared/auth_styles' %>
