<div id="wrapper">

  <%= render 'devise/shared/auth_showcase' %>

  <!-- ── PANEL DERECHO: Formulario ── -->
  <div id="left">
    <div id="signin">
      <div class="logo">
        <%= render 'users/flash_message_session', titulo: t('system_login') %>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>

        <div>
          <label><%= t('new_password') %></label>
          <%= f.input :password, required: true, autofocus: true, label: false, placeholder: t('new_password'), input_html: { class: 'form-control'} %>
        </div>

        <div>
          <label><%= t('confirm_new_password') %></label>
          <%= f.input :password_confirmation, required: true, label: false,
                      placeholder: t('confirm_new_password'),
                      input_html: { class: 'form-control' } %>
        </div>

        <br/>
        <div>
          <%= f.button :submit, t('aceptar'), class: 'primary-btn', disabled_with: t('signing_in') %>
        </div>
      <% end %>

      <div class="back-link">
        <%= link_to new_session_path(resource_name) do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>
          <%= t('back_to_login') %>
        <% end %>
      </div>

      <%= render 'layouts/flash_messages' %>
    </div>

    <footer id="main-footer">
      <%= t('copyright') %> &copy; <%= Time.now.strftime("%Y") %> <b><%= t('imahsoftware') %></b> · <span class="footer-app"><%= t('bacwins') %></span> · <%= t('all_rights_reserved') %>.
    </footer>
  </div>

</div>

<%= render 'devise/shared/auth_styles' %>

<style>
    /* Back link (solo para esta vista) */
    .back-link { margin-top: 1.2rem; text-align: center; }
    .back-link a {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-size: 1rem; font-weight: 500;
        color: var(--muted); text-decoration: none;
        transition: color .2s;
    }
    .back-link a:hover { color: var(--blue); }
</style>
