<% if @jobs != nil %>
  <div class="table-responsive">
    <table class="table table-bordered table-condensed table-striped">
      <thead>
        <tr class="thcolor">
          <th class="text-center"><%= t :actions %></th>
          <th class="text-center"><%= t :job_name %></th>
          <th class="text-center"><%= t :job_style %></th>
          <th class="text-center">Session ID</th>
          <th class="text-center">Slave Process ID</th>
          <th class="text-center">Elapsed Time</th>
          <th class="text-center">CPU Used</th>
          <th class="text-center">Log ID</th>
        </tr>
      </thead>
      <tbody>
        <% @jobs.each do |job| %>
          <tr>
            <td class="text-center">
              <% if is_supersygma %>
                <%= link_to administracion_killjob_path(name: job.job_name), method: :post, data: { confirm: t(:dangerous_button), toggle: 'tooltip' }, title: t(:kill_job) do %>
                  <button class="btn btn-xs btn-danger"><i class="fa fa-minus-square"></i></button>
                <% end %>
              <% end %>
            </td>
            <td class="text-center"><%= job.job_name rescue nil %></td>
            <td class="text-center"><%= job.job_style rescue nil %></td>
            <td class="text-center"><%= job.session_id rescue nil %></td>
            <td class="text-center"><%= job.slave_process_id rescue nil %></td>
            <td class="text-center"><%= job.elapsed_time rescue nil %></td>
            <td class="text-center"><%= job.cpu_used rescue nil %></td>
            <td class="text-center"><%= job.log_id rescue nil %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-danger
">
    <h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%= t :no_jobs_running %>
  </div>
<% end %>
