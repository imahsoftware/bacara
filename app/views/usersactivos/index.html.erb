<% if is_sygma %>
  <div class="box box-primary">
    <div class="box-header">
      <legend>Usuarios con sesión activa <span data-toggle="tooltip" title="" class="badge bg-yellow" data-original-title="<%= @usersactivos.count %> usuarios conectados"><%= @usersactivos.count %></span></legend>
      <div class="box-tools pull-right">
        <%= search_form_for @q, url: usersactivos_path do |f| %>
          <div class="input-group input-group-sm" style="width: 180px;">
            <%= f.search_field :email_or_username_or_nombre_or_identificacion_cont, class: 'form-control pull-right', placeholder: 'Buscar...' %>
            <div class="input-group-btn">
              <%= button_tag(type: "submit", class: "btn btn-default") do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="box-body">
      <% if @usersactivos.present? %>
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead>
              <tr class="thcolor">
                <th>ID</th>
                <th>Usuario</th>
                <th>Nombre</th>
                <th>Portafolio</th>
                <th>Documento</th>
                <th>Fecha y hora de conexión</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @usersactivos.each do |user| %>
                <tr>
                  <td><%= user.id rescue nil %></td>
                  <td><%= user.username rescue nil %></td>
                  <td><%= user.nombre rescue nil %></td>
                  <td><%= user.portafolio.nombre rescue nil %></td>
                  <td><%= user.identificacion rescue nil %></td>
                  <td><%= user.current_sign_in_at.strftime("%Y-%m-%d %I:%M %p") rescue nil %></td>
                  <td>
                    <%= link_to cerrarsesion_usersactivos_path(id: user.id), data: { toggle: 'tooltip', confirm: '¿Esta seguro?' }, title: 'Desactivar sesión' do %>
                      <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="box-tools pull-right">
          <%= will_paginate @usersactivos, renderer: BootstrapPagination::Rails %>
        </div>
      <% else %>
        <h4 class="text-center">No se encontraron datos</h4>
      <% end %>
    </div>
  </div>
<% else %>
  <h2>Página no encontrada</h2>
<% end %>
